---
import PageLayout from '../layouts/PageLayout.astro';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Motion design services | Motion Story",
  "description": "Films for products and complex ideas. Product demos, explainers, and motion graphics. Work directly with Dan Neale.",
  "url": "https://motionstory.com.au/services/",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://motionstory.com.au/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://motionstory.com.au/services/" },
  ],
};

const byAudience = [
  { href: "/saas-explainer-videos/", label: "SaaS & technology", blurb: "Software that needs to make sense before anyone logs in." },
  { href: "/finance-explainer-videos/", label: "Fintech & payments", blurb: "Money software, shown clearly enough to trust." },
  { href: "/cybersecurity-explainer-videos/", label: "Cybersecurity", blurb: "The risk and the control, clear for a non-specialist buyer." },
  { href: "/startups/", label: "Startups", blurb: "The first film, before the deck." },
  { href: "/agencies/", label: "Agencies & studios", blurb: "White label, or working beside your team." },
  { href: "/causes/", label: "Causes & nonprofits", blurb: "Who you help, and why someone should care." },
];

const byFormat = [
  { href: "/which-film/", label: "Which film", blurb: "Explainer, product demo, onboarding, or launch. Start here if you are not sure." },
  { href: "/saas-explainer-videos/", label: "SaaS videos", blurb: "A film of the product, for the homepage or a sales deck." },
  { href: "/explainer-videos/", label: "Explainer videos", blurb: "When the idea takes too long to explain in a meeting." },
  { href: "/product-demo-videos/", label: "Product demo videos", blurb: "The product on screen: demos, onboarding, and tutorials." },
  { href: "/freelance-motion-graphic-designer/", label: "Freelance motion designer", blurb: "You work with Dan. Story, storyboard, design, and animation." },
  { href: "/animation-production-company/", label: "Animation production company", blurb: "Motion graphics, explainers, and product films. I direct the work." },
  { href: "/technology-videos/", label: "Technology videos", blurb: "Platforms and technical buyers, explained clearly." },
];
---

<PageLayout
  title="Motion design services | Motion Story"
  description="Films for products and complex ideas. Product demos, explainers, and motion graphics. Work directly with Dan Neale."
  floatSubject="Motion design services"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="landing">
    <header class="landing-hero">
      <span class="landing-eyebrow">Services</span>
      <h1 class="landing-title">What I make, and who it is for.</h1>
      <p class="landing-lede">I help teams explain products and complex ideas. Pick the path that matches the brief.</p>
    </header>

    <p class="landing-clients">United Nations · TransferWise · Schoolbox · Smokeball · Atomic · Mosaic · RSPCA · Meltwater</p>

    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">By audience</span>
      <div class="landing-cred">
        {byAudience.map((item) => (
          <a href={item.href} class="landing-cred-row group" style="text-decoration: none; color: inherit;">
            <h2 class="landing-cred-label group-hover:opacity-55 transition-opacity">{item.label} →</h2>
            <p class="landing-cred-body">{item.blurb}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">By format</span>
      <div class="landing-cred">
        {byFormat.map((item) => (
          <a href={item.href} class="landing-cred-row group" style="text-decoration: none; color: inherit;">
            <h2 class="landing-cred-label group-hover:opacity-55 transition-opacity">{item.label} →</h2>
            <p class="landing-cred-body">{item.blurb}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">Details</span>
      <div class="fold">
        <details class="fold-item">
          <summary>Cost</summary>
          <div class="fold-body">
            <p>From $5,000. Most projects land around $10,000 to $15,000. Fixed quote upfront.</p>
          </div>
        </details>
        <details class="fold-item">
          <summary>How I work</summary>
          <div class="fold-body">
            <p>You work with me. Story, storyboard, design, and animation. Agencies can work white label or alongside their team.</p>
          </div>
        </details>
      </div>
    </section>
  </div>
</PageLayout>
