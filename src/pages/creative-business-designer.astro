---
import PageLayout from '../layouts/PageLayout.astro';
import VimeoEmbed from '../components/VimeoEmbed';
import { GOOGLE_RATING, VERIFIED_CLIENT_REVIEWS } from '../data/reviews';
import { SPINE_TICKER_ROW_A, SPINE_TICKER_ROW_B } from '../data/landing-pages/spine-shared';

const BOOKING = '/book/';
const EMAIL = 'mailto:daniel@motionstory.com.au';
const SESSION_FROM = 'From $1,500';

const clients = [
  'United Nations',
  'TransferWise',
  'Atomic',
  'Wipster',
  'Mosaic',
  'Method',
  'Amex',
  'AWS',
  'NSW Government',
  'RSPCA',
];

const tickerA = [...SPINE_TICKER_ROW_A, ...SPINE_TICKER_ROW_A];
const tickerB = [...SPINE_TICKER_ROW_B, ...SPINE_TICKER_ROW_B];

const heroOutcomes = [
  'Website live in days',
  'Pitch deck and video ready before your next meeting',
  'App prototype in your hands in a fortnight',
  'Sales funnel built in two weeks',
  'A rough idea turned into something real, fast',
];

const steps = [
  {
    label: 'We talk',
    body: `A paid problem-solving session. An hour or a day, depending on the size of it. ${SESSION_FROM}. You bring the mess. We map out what's actually wrong and what to do about it.`,
  },
  {
    label: 'I build it',
    body: 'Not a report. Not a deck of recommendations you file away. The actual thing: the website, the video, the prototype, the funnel.',
  },
  {
    label: 'You get on with running your business',
    body: 'One contact. No agency, no committee, no six-week onboarding.',
  },
];

const builds = [
  {
    label: 'Software and app prototyping',
    body: "Working prototypes, not mockups. I build my own apps, so I know what's realistic and what's a fantasy your developer will quietly hate you for.",
  },
  {
    label: 'Video and motion graphics',
    body: 'Twenty years of it. Explainers, product demos, brand films, launch content. This is my craft.',
  },
  {
    label: 'Websites',
    body: 'Fast, sharp, built to convert. Days, not months.',
  },
  {
    label: 'Automation and technical problem-solving',
    body: 'Quotes taking too long. Leads leaking out of a bad funnel. Manual work eating your week. Usually solvable.',
  },
  {
    label: 'Big ideas and strategy',
    body: "Marketing thinking, positioning, launch plans. Including getting your brief sharp enough to hand to a bigger agency if that's genuinely what you need.",
  },
];

const fits = [
  {
    q: "I've got an idea but nothing to show for it.",
    a: 'A short sprint and you walk away with a live site and a story that makes it sound real.',
  },
  {
    q: "I'm pitching for money and I'm not ready.",
    a: 'Deck and video, done before the meeting.',
  },
  {
    q: "I've built it but nobody knows about it.",
    a: 'A launch plan. And I build the assets, not just the plan.',
  },
  {
    q: "People still don't get what we do.",
    a: 'Video content strategy, then I make the videos.',
  },
  {
    q: "I know what's next but I've got no time to work it out.",
    a: 'A working session and a clear roadmap. What to do, in what order, what it costs.',
  },
];

const ownProducts = [
  {
    name: 'Freewheel',
    body: 'Cycling tour and navigation app.',
    href: 'https://freewheeltours.com/',
  },
  {
    name: 'SMASH Invoices',
    body: 'Voice-to-invoice app for tradies.',
    href: 'https://smashinvoices.com/',
  },
];

const work = [
  { title: 'Cart-share / Startup Explainer', link: '/casestudy/cart-share-explainer/', vimeoId: '792094835' },
  { title: 'Atomic / In-App Messaging', link: '/casestudy/atomic-in-app-messaging/', vimeoId: '861022443' },
  { title: 'Trusyft / Product Promo', link: '/casestudy/trusyft-animated-product-promo/', vimeoId: '863428533' },
  { title: 'Wipster / Video Feedback Tool', link: '/casestudy/wipster-product-overview/', vimeoId: '648360270' },
  { title: 'ARK / Product Concept', link: '/casestudy/ark-product-concept/', vimeoId: '818912051' },
  { title: 'Good2Pay / Paperless Invoicing', link: '/casestudy/good2pay/', vimeoId: '448704979' },
];

const [featured, ...rest] = work;
const proofReview =
  VERIFIED_CLIENT_REVIEWS.find((r) => r.company === 'Method Recycling') ?? VERIFIED_CLIENT_REVIEWS[2];
const pageReview = VERIFIED_CLIENT_REVIEWS[0];

const faqs = [
  {
    label: 'What does a session cost?',
    body: `Paid problem-solving session, ${SESSION_FROM}. An hour or a day depending on the size of it. Filters tyre-kickers. You pay for the thinking.`,
  },
  {
    label: 'What happens after the session?',
    body: 'If there is something to build, I quote the build and make it. Website, video, prototype, funnel, or a mix. Fixed quote before production starts.',
  },
  {
    label: 'Who will I work with?',
    body: 'Me. Dan Neale. One contact. No agency layer.',
  },
  {
    label: 'Where are you based?',
    body: 'Byron Bay, Australia. Remote with clients worldwide.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Creative Business Designer',
  description:
    'Creative business designer under Motion Story. Paid problem-solving sessions, then build: websites, video, app prototypes, sales funnels. Work directly with Dan Neale.',
  provider: {
    '@type': 'Person',
    name: 'Daniel Neale',
    jobTitle: 'Creative Business Designer',
    url: 'https://motionstory.com.au/about/',
    image: 'https://motionstory.com.au/daniel-neale.jpg',
    worksFor: { '@type': 'Organization', name: 'Motion Story', url: 'https://motionstory.com.au' },
  },
  serviceType: 'Creative Business Design',
  areaServed: ['Australia', 'Worldwide'],
  offers: {
    '@type': 'Offer',
    name: 'Problem-solving session',
    priceCurrency: 'AUD',
    price: '1500',
    description: 'Paid problem-solving session. An hour or a day depending on scope.',
    url: 'https://motionstory.com.au/creative-business-designer/',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://motionstory.com.au/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Creative Business Designer',
      item: 'https://motionstory.com.au/creative-business-designer/',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.label,
    acceptedAnswer: { '@type': 'Answer', text: f.body },
  })),
};
---

<PageLayout
  floatSubject="Creative business designer session"
  title="Creative Business Designer | Motion Story"
  description="What's holding your business back? Paid problem-solving sessions, then I build it. Websites, video, app prototypes, sales funnels. 20 years. Work with Dan."
  showCTA={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="landing">
    <header class="landing-hero">
      <span class="landing-eyebrow landing-reveal" style="--d: 0">Creative business designer</span>
      <h1 class="landing-title landing-reveal" style="--d: 1">
        What's holding your business back?
      </h1>
      <p class="landing-lede landing-reveal" style="--d: 2">
        I can bring your vision to life.
      </p>
      <ul class="mt-8 space-y-3 max-w-xl landing-reveal" style="--d: 3">
        {heroOutcomes.map((item) => (
          <li class="flex gap-3 text-[17px] leading-[1.45] tracking-[-0.011em] text-[#333]">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-[17px] leading-[1.5] tracking-[-0.011em] text-[#555] max-w-xl landing-reveal" style="--d: 4">
        Work directly with a creative business designer. 20 years of it.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-5 landing-reveal" style="--d: 5">
        <a
          href={BOOKING}
          class="inline-flex min-h-[48px] items-center justify-center rounded-[10px] bg-black px-7 py-3.5 text-[15px] font-medium tracking-[-0.01em] text-white transition-opacity hover:opacity-90"
        >
          Book a problem-solving session
        </a>
        <span class="text-[14px] tracking-[-0.01em] text-[#888]">{SESSION_FROM}</span>
      </div>
    </header>

    <p class="landing-clients landing-reveal" style="--d: 6">
      {clients.join(' · ')}
    </p>
  </div>

  <section class="fcd-ticker border-y border-black/10" aria-label="Trusted by">
    <div class="mx-auto max-w-7xl px-8 pt-8 sm:pt-9">
      <p class="landing-eyebrow text-center !mb-0 tracking-[0.18em]">Twenty years of client work through Motion Story</p>
    </div>
    <div class="mt-5 space-y-0 pb-7 sm:mt-6 sm:pb-8">
      <div class="fcd-ticker-mask">
        <div class="fcd-ticker-track">
          {tickerA.map((name) => (
            <span class="fcd-ticker-item">
              <span class="fcd-ticker-name">{name}</span>
              <span class="fcd-ticker-dot" aria-hidden="true">·</span>
            </span>
          ))}
        </div>
      </div>
      <div class="fcd-ticker-mask">
        <div class="fcd-ticker-track fcd-ticker-reverse">
          {tickerB.map((name) => (
            <span class="fcd-ticker-item">
              <span class="fcd-ticker-name">{name}</span>
              <span class="fcd-ticker-dot" aria-hidden="true">·</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="landing">
    <section class="landing-section">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-start">
        <div class="md:col-span-4">
          <div class="aspect-[4/5] overflow-hidden mb-4 max-w-sm">
            <img
              src="/daniel-neale.jpg"
              alt="Dan Neale, creative business designer at Motion Story"
              class="w-full h-full object-cover"
              loading="eager"
              width="640"
              height="800"
            />
          </div>
          <p class="text-metadata">Dan Neale · Byron Bay, Australia</p>
        </div>
        <div class="md:col-span-8">
          <span class="landing-eyebrow landing-section-label">How it works</span>
          <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.75rem)] font-bold tracking-tight leading-[1.1] mb-5 max-w-[18ch]">
            One person. One session. Then it gets built.
          </h2>
          <p class="text-[17px] leading-[1.5] tracking-[-0.011em] text-[#555] max-w-xl mb-10">
            Most people sell you advice or sell you production. I do both, which is why this is simple.
          </p>
          <ol class="space-y-8 max-w-xl">
            {steps.map((step, i) => (
              <li>
                <p class="landing-eyebrow !text-accent mb-2">0{i + 1}</p>
                <h3 class="font-display text-xl md:text-2xl font-bold tracking-tight mb-2">{step.label}</h3>
                <p class="text-[16px] leading-[1.5] tracking-[-0.011em] text-[#555]">{step.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">What I can build</span>
      <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.75rem)] font-bold tracking-tight leading-[1.1] mb-10 max-w-[16ch]">
        From idea to the actual thing.
      </h2>
      <div class="landing-cred">
        {builds.map((item) => (
          <div class="landing-cred-row">
            <h3 class="landing-cred-label">{item.label}</h3>
            <p class="landing-cred-body">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">Is this you?</span>
      <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.75rem)] font-bold tracking-tight leading-[1.1] mb-10 max-w-[14ch]">
        If this sounds familiar.
      </h2>
      <div class="landing-faq">
        {fits.map((item) => (
          <div class="landing-faq-row">
            <h3 class="landing-faq-label">“{item.q}”</h3>
            <p class="text-body">{item.a}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">Proof</span>
      <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.75rem)] font-bold tracking-tight leading-[1.1] mb-5 max-w-[20ch]">
        Client work. And my own products.
      </h2>
      <p class="text-[17px] leading-[1.5] tracking-[-0.011em] text-[#555] max-w-xl mb-10">
        Twenty years of client work through Motion Story. Explainer and motion graphics for tech companies and brands, alongside top Australian agencies.
      </p>
      <p class="text-[17px] leading-[1.5] tracking-[-0.011em] text-[#333] max-w-xl mb-6 font-medium">
        And I build my own things:
      </p>
      <ul class="divide-y divide-black/10 border-y border-black/10 max-w-xl mb-12">
        {ownProducts.map((item) => (
          <li class="py-5">
            {item.href ? (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="font-display text-xl font-bold tracking-tight border-b border-black/20 hover:border-black transition-colors"
              >
                {item.name}
              </a>
            ) : (
              <span class="font-display text-xl font-bold tracking-tight">{item.name}</span>
            )}
            <p class="mt-2 text-[16px] leading-[1.5] tracking-[-0.011em] text-[#555]">{item.body}</p>
          </li>
        ))}
      </ul>
      <p class="text-[16px] leading-[1.5] tracking-[-0.011em] text-[#555] max-w-xl">
        Concept to shipped product, both of them. Same hands.
      </p>
    </section>

    <section id="selected-work" class="landing-section">
      <div class="landing-section-head">
        <span class="landing-eyebrow">Selected client work</span>
        <span class="landing-eyebrow landing-count">{String(work.length).padStart(2, '0')}</span>
      </div>

      {featured && (
        <article class="landing-featured group">
          <span class="landing-work-index">01</span>
          <VimeoEmbed
            client:visible
            vimeoId={featured.vimeoId}
            title={featured.title}
            loading="eager"
            autoColor={true}
            className="landing-featured-media"
          />
          <a href={featured.link} class="landing-work-meta">
            <h2 class="landing-featured-title">{featured.title}</h2>
            <span class="landing-work-link">View case study →</span>
          </a>
        </article>
      )}

      <figure class="landing-proof">
        <blockquote class="landing-proof-quote">“{proofReview.quote}”</blockquote>
        <figcaption class="landing-proof-cap">
          <span class="landing-proof-by">{proofReview.name}</span>
          <span class="landing-proof-role">{proofReview.role}, {proofReview.company}</span>
        </figcaption>
      </figure>

      <div class="landing-work-grid">
        {rest.map((study, i) => (
          <article class="landing-work-card group">
            <span class="landing-work-index">{String(i + 2).padStart(2, '0')}</span>
            <VimeoEmbed
              client:visible
              vimeoId={study.vimeoId}
              title={study.title}
              loading="lazy"
              autoColor={true}
              className="landing-work-media"
            />
            <a href={study.link} class="landing-work-meta">
              <h2 class="landing-work-title">{study.title}</h2>
              <span class="landing-work-link">View case study →</span>
            </a>
          </article>
        ))}
      </div>

      <p class="landing-all-work landing-all-work--end">
        <a href="/work/">See the full portfolio →</a>
      </p>
    </section>

    <section class="landing-section">
      <blockquote class="font-display text-xl md:text-2xl font-medium tracking-tight leading-snug max-w-2xl mb-6">
        “{pageReview.quote}”
      </blockquote>
      <p class="text-metadata mb-4">{pageReview.name} · {pageReview.role}, {pageReview.company}</p>
      <p class="text-metadata">
        <span class="text-accent">★★★★★</span> {GOOGLE_RATING.score} on Google · <a href="/reviews/" class="border-b border-black/20 hover:border-black transition-colors">All reviews →</a>
      </p>
    </section>

    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">Why I do this</span>
      <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.75rem)] font-bold tracking-tight leading-[1.1] mb-5 max-w-[18ch]">
        I think like a builder, not a supplier.
      </h2>
      <div class="max-w-xl space-y-5 text-[17px] leading-[1.5] tracking-[-0.011em] text-[#555]">
        <p>
          I'm building my own products alongside this work. So I don't think like a supplier waiting for a brief. I think like someone who's had to solve the same problems you're solving.
        </p>
        <p>
          I'd rather spend my time with people building real things than making another corporate video. If that's you, we'll get on.
        </p>
      </div>
    </section>

    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">FAQ</span>
      <div class="landing-faq">
        {faqs.map((faq) => (
          <div class="landing-faq-row">
            <h3 class="landing-faq-label">{faq.label}</h3>
            <p class="text-body">{faq.body}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <section class="site-cta">
    <div class="max-w-xl mx-auto px-8 py-24 md:py-28 text-center">
      <div class="mx-auto mb-8 h-20 w-20 overflow-hidden rounded-full ring-1 ring-white/15 sm:h-24 sm:w-24">
        <img
          src="/daniel-neale.jpg"
          alt="Dan Neale"
          class="h-full w-full object-cover"
          loading="lazy"
          width="96"
          height="96"
        />
      </div>
      <h2 class="font-display text-3xl md:text-5xl font-bold tracking-tight mb-5 text-balance">
        Tell me what's holding you back.
      </h2>
      <p class="mx-auto max-w-md text-[17px] leading-[1.5] tracking-[-0.011em] text-white/60 mb-3">
        Book a problem-solving session and let's work out what to do about it.
      </p>
      <p class="text-[14px] tracking-[-0.01em] text-white/40 mb-10">{SESSION_FROM}</p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center sm:gap-6">
        <a
          href={BOOKING}
          class="inline-flex min-h-[48px] items-center justify-center rounded-[10px] bg-accent px-8 py-3.5 text-[15px] font-medium tracking-[-0.01em] text-white transition-opacity hover:opacity-90"
        >
          Book a session
        </a>
        <a
          href={EMAIL}
          data-astro-reload
          class="inline-flex min-h-[44px] items-center text-[15px] font-medium tracking-[-0.01em] text-white/55 transition-colors hover:text-white"
        >
          Or email me directly
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .fcd-ticker-mask {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .fcd-ticker-track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: fcd-ticker-scroll 48s linear infinite;
  }

  .fcd-ticker-track.fcd-ticker-reverse {
    animation-name: fcd-ticker-scroll-reverse;
    animation-duration: 56s;
  }

  .fcd-ticker-item {
    display: inline-flex;
    align-items: center;
  }

  .fcd-ticker-name {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: rgba(10, 10, 10, 0.62);
    white-space: nowrap;
  }

  .fcd-ticker-dot {
    margin: 0 1.5rem;
    color: var(--color-accent, #ff0000);
    opacity: 0.9;
  }

  @media (min-width: 640px) {
    .fcd-ticker-dot {
      margin: 0 2rem;
    }
  }

  @keyframes fcd-ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @keyframes fcd-ticker-scroll-reverse {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .fcd-ticker-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      max-width: 72rem;
      margin: 0 auto;
      padding: 0 2rem;
      gap: 0.5rem 0;
    }
  }
</style>
