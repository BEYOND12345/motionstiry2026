---
import BaseLayout from '../layouts/BaseLayout.astro';
import CreativeBusinessLanding from '../components/LandingPage/CreativeBusinessLanding';
import { creativeBusinessDesignerOffer } from '../data/landing-pages/creative-business-designer';
import '../styles/global.css';

const config = creativeBusinessDesignerOffer;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Creative Business Designer',
  description: config.seo.metaDescription,
  provider: {
    '@type': 'Person',
    name: 'Daniel Neale',
    jobTitle: 'Creative Business Designer',
    url: 'https://motionstory.com.au/about/',
    image: 'https://motionstory.com.au/daniel-neale.jpg',
    worksFor: { '@type': 'Organization', name: 'Motion Story', url: 'https://motionstory.com.au' },
  },
  serviceType: 'Creative Business Design',
  areaServed: ['Australia', 'Worldwide'],
  offers: {
    '@type': 'Offer',
    name: 'Problem-solving session',
    priceCurrency: 'AUD',
    price: '1500',
    description: 'Paid problem-solving session. An hour or a day depending on scope.',
    url: 'https://motionstory.com.au/creative-business-designer/',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://motionstory.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://motionstory.com.au/services/' },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Creative Business Designer',
      item: 'https://motionstory.com.au/creative-business-designer/',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: config.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout
  title={config.seo.titleTag}
  description={config.seo.metaDescription}
  canonicalUrl={`https://motionstory.com.au${config.seo.canonicalPath}`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <CreativeBusinessLanding client:load config={config} />
</BaseLayout>
