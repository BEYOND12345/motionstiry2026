---
import BaseLayout from '../layouts/BaseLayout.astro';
import CreativeBusinessLanding from '../components/LandingPage/CreativeBusinessLanding';
import '../styles/global.css';

const title = 'Creative Business Designer | Motion Story';
const description =
  "What's holding your business back? Paid problem-solving sessions, then I build it. Websites, apps, sales funnels, video, and strategy. 20 years. Work with Dan.";

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Creative Business Designer',
  description,
  provider: {
    '@type': 'Person',
    name: 'Daniel Neale',
    jobTitle: 'Creative Business Designer',
    url: 'https://motionstory.com.au/about/',
    image: 'https://motionstory.com.au/daniel-neale.jpg',
    worksFor: { '@type': 'Organization', name: 'Motion Story', url: 'https://motionstory.com.au' },
  },
  serviceType: 'Creative Business Design',
  areaServed: ['Australia', 'Worldwide'],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://motionstory.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://motionstory.com.au/services/' },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Creative Business Designer',
      item: 'https://motionstory.com.au/creative-business-designer/',
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl="https://motionstory.com.au/creative-business-designer/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <CreativeBusinessLanding client:load />
</BaseLayout>
