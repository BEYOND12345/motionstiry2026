---
import PageLayout from '../layouts/PageLayout.astro';
import FreelanceMotionPage from '../components/FreelanceMotionPage.astro';
import {
  FREELANCE_CANONICAL,
  FREELANCE_DESCRIPTION,
  FREELANCE_FAQS,
  FREELANCE_TITLE,
} from '../data/freelance-motion-page';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Freelance motion graphic designer',
  description: FREELANCE_DESCRIPTION,
  provider: {
    '@type': 'Person',
    name: 'Daniel Neale',
    jobTitle: 'Freelance motion graphic designer',
    url: 'https://motionstory.com.au/about/',
    worksFor: { '@type': 'Organization', name: 'Motion Story', url: 'https://motionstory.com.au' },
  },
  serviceType: 'Freelance motion design',
  areaServed: ['Australia', 'Worldwide'],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://motionstory.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Freelance motion graphic designer', item: 'https://motionstory.com.au/freelance-motion-graphic-designer/' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FREELANCE_FAQS.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<PageLayout
  title={FREELANCE_TITLE}
  description={FREELANCE_DESCRIPTION}
  canonicalUrl={FREELANCE_CANONICAL}
  floatSubject="Freelance motion designer"
  ctaHeading="Tell me what you are trying to explain."
  showCTA={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <FreelanceMotionPage />
</PageLayout>
