---
import PageLayout from '../../layouts/PageLayout.astro';
import TrajectoryProposalLanding from '../../components/TrajectoryProposalLanding.astro';
import { trajectoryProposal } from '../../data/sales-pages/trajectory';

const c = trajectoryProposal;
---

<PageLayout
  title={c.seo.titleTag}
  description={c.seo.metaDescription}
  canonicalUrl="https://motionstory.com.au/p/trajectory/"
  floatSubject="Trajectory proposal"
  showCTA={false}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <TrajectoryProposalLanding />
</PageLayout>
