---
import PageLayout from '../layouts/PageLayout.astro';
import { GOOGLE_RATING, pickVerifiedReviews } from '../data/reviews';

const aboutReviews = pickVerifiedReviews('about', 3);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Dan Neale | Motion Story",
  "url": "https://motionstory.com.au/about/",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".text-body"]
  },
  "mainEntity": {
    "@type": "Person",
    "name": "Dan Neale",
    "jobTitle": "Creative Director",
    "worksFor": { "@type": "Organization", "name": "Motion Story" },
    "knowsAbout": [
      "Motion Design",
      "Creative Direction",
      "Storytelling",
      "Explainer Videos",
      "Product Videos",
      "Storyboarding",
      "SaaS Marketing",
      "Agency Creative Direction"
    ],
    "sameAs": [
      "https://www.linkedin.com/in/danielneale",
      "https://vimeo.com/wearemotionstory"
    ]
  }
};
---

<PageLayout
  title="About Dan Neale | Motion Story"
  description="Meet Dan Neale — the creative director behind Motion Story. 500+ projects since 2012, from the United Nations to TransferWise's first video. Byron Bay."
  activeNav="About"
  ctaHeading="Tell me about the project. I'll tell you what I see."
  floatSubject="About Motion Story"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://motionstory.com.au/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://motionstory.com.au/about/" }
      ]
    })} />
  </Fragment>

  <div class="landing">
    <header class="landing-hero">
      <span class="landing-eyebrow">About</span>
      <h1 class="landing-title">I'm Dan. Motion Story is me.</h1>
      <p class="landing-lede">Creative director, and the person who makes the work. I take complicated things — software, processes, invisible value — and turn them into films people actually understand.</p>
    </header>

    <p class="landing-clients">United Nations · TransferWise · Amex · Cartier · Atomic · Mosaic · RSPCA · Meltwater · Wipster</p>

    <!-- The story -->
    <section class="landing-section">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-16 items-start">
        <div>
          <div class="aspect-[4/5] overflow-hidden mb-6">
            <img src="/daniel-neale.jpg" alt="Dan Neale, creative director of Motion Story" class="w-full h-full object-cover" loading="eager" />
          </div>
          <p class="text-metadata">Dan Neale</p>
          <p class="text-metadata opacity-40">Byron Bay, Australia</p>
        </div>
        <div class="md:col-span-2 space-y-8 max-w-2xl">
          <p class="text-body text-lg leading-relaxed">
            Motion Story has been me since 2012 — making motion since 2010, back when the explainer video first became a thing. You brief me, I run the project. No account manager in between, no junior animating it while a senior name sits on the website. When a job needs extra hands I bring in specialists I trust and direct — but nothing gets handed off. The person you talk to is the person responsible for the work.
          </p>
          <p class="text-body text-lg leading-relaxed">
            Fifteen years and 500-plus projects in, mostly for people with something genuinely hard to explain. Software that does six things at once. A process nobody can describe in a sentence. A product where the value is real but invisible. It's taken the work from the United Nations to TransferWise's first-ever video, made directly with their CEO — to Amex, Cartier, and a long line of SaaS companies whose products you can't point a camera at.
          </p>
          <p class="text-body text-lg leading-relaxed">
            A quick honest bit: I'm not on social media. Barely touch it. Haven't updated my LinkedIn in about two years and I've made my peace with that. It's not strategy — I'm just quiet, and I'd rather be working or outside than posting about working. That's the type of bloke I am. So no big feed, no showreel going viral. People find me through the work.
          </p>
          <p class="text-body text-lg leading-relaxed">
            The rest of life is Byron Bay: I'm a father, a surfer, and a big-time animal lover. I put everything into the work — it's the only way I know how to do it.
          </p>
        </div>
      </div>
    </section>

    <!-- Who I work with -->
    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">Who I work with</span>
      <div class="space-y-8 max-w-2xl">
        <p class="text-body text-lg leading-relaxed">
          All sorts, from all over. Firm managers in New York, startups in New Zealand, mum and dad shops here in Byron Bay. I work remotely, always have — if you're in the US, the work happens while you sleep.
        </p>
        <p class="text-body text-lg leading-relaxed">
          I'm not a big studio and I won't pretend to be. I don't have producers, so the massive, sprawling, twenty-people-on-a-call jobs aren't my thing — honestly, I'm not that interested in them either. But the nice projects, the stylish ones, the well-thought-out meaningful ones? That's me. A good alternative to a big studio, without the overhead.
        </p>
      </div>
    </section>

    <!-- What I actually do -->
    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">What I actually do</span>
      <div class="space-y-8 max-w-2xl">
        <p class="text-body text-lg leading-relaxed">
          More than design and animation. I'm the big-picture person — strategy, creative direction, working out the story before anyone opens After Effects.
        </p>
        <p class="text-body text-lg leading-relaxed">
          Here's the thing I'm actually good at: send me a brief, or just talk me through a project on a call, and I can see it. The whole thing — backwards, forwards, every component, finished — in my head while we're still talking. And I can get it onto paper so you see exactly what I see.
        </p>
        <p class="text-body text-lg leading-relaxed">
          That's the gold. That's what makes the rest of the project run smoothly and come out unique instead of generic. A chatbot will write you a script — I've seen those projects, and it gets it wrong in ways you don't notice until it's too late. This part needs a human who's done it a thousand times.
        </p>
      </div>
    </section>

    <!-- How I like to work -->
    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">How I like to work</span>
      <div class="space-y-8 max-w-2xl">
        <p class="text-body text-lg leading-relaxed">
          The brief is where most videos go wrong, not the animation. Founders and engineers brief badly because they try to include everything — but a viewer gives you eight seconds and one idea. I'd rather have six bullet points than a twelve-page document.
        </p>
        <p class="text-body text-lg leading-relaxed">
          Then it's concept, storyboard, style, animation — in that order, always. A change costs an hour at storyboard and eight hours once it's animated.
        </p>
        <p class="text-body text-lg leading-relaxed">
          If you're a SaaS company, bring me in early. Let me do the storyboarding, the story, the heavy lifting up front. Bring in your other creatives too if you want — I'll work around them. Think of me as a fractional creative director you can drop into a project. No hand-holding; I work like part of the team.
        </p>
        <p class="text-body text-lg leading-relaxed">
          And if the brief's wrong, I'll tell you. You're not paying me to nod.
        </p>
      </div>
    </section>

    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">What clients say</span>
      <p class="landing-clients" style="margin-bottom: 3rem;">
        {GOOGLE_RATING.score} ★★★★★ on Google · {GOOGLE_RATING.count} reviews · <a href="/reviews/" style="border-bottom: 1px solid currentColor;">All reviews</a>
      </p>
      <div class="landing-cred">
        {aboutReviews.map((review) => (
          <div class="landing-cred-row">
            <h3 class="landing-cred-label">{review.company}</h3>
            <p class="landing-cred-body">“{review.quote}” — {review.name}, {review.role}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="landing-section">
      <span class="landing-eyebrow landing-section-label">Questions</span>
      <div class="landing-faq">
        <div class="landing-faq-row">
          <h3 class="landing-faq-label">Cost</h3>
          <p class="text-body">From $5,000. I prefer projects around $10,000–$15,000. Fixed quote upfront.</p>
        </div>
        <div class="landing-faq-row">
          <h3 class="landing-faq-label">Timeline</h3>
          <p class="text-body">Most projects take 3–6 weeks from kickoff to delivery.</p>
        </div>
        <div class="landing-faq-row">
          <h3 class="landing-faq-label">Capacity</h3>
          <p class="text-body">Limited concurrent projects, on purpose. If you want silent execution with no questions, I am not the fit. If you want the story found and built properly, get in touch.</p>
        </div>
      </div>
    </section>

    <nav class="landing-links" aria-label="Related pages">
      <a href="/work/" class="landing-link-card group">
        <span class="landing-eyebrow mb-4 block">Work</span>
        <p class="landing-link-label">See all work →</p>
      </a>
      <a href="/process/" class="landing-link-card group">
        <span class="landing-eyebrow mb-4 block">Process</span>
        <p class="landing-link-label">How I work →</p>
      </a>
      <a href="/explainer-videos/" class="landing-link-card group">
        <span class="landing-eyebrow mb-4 block">Explainers</span>
        <p class="landing-link-label">Explainer videos →</p>
      </a>
    </nav>
  </div>
</PageLayout>
