---
import PageLayout from '../layouts/PageLayout.astro';
import { GOOGLE_RATING, VERIFIED_CLIENT_REVIEWS } from '../data/reviews';
import { getShowcaseProjects } from '../data/projects';

const strapline = VERIFIED_CLIENT_REVIEWS[0]; // Acodis — "part of our team"
const aboutWork = getShowcaseProjects().slice(0, 3);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Dan Neale | Motion Story",
  "url": "https://motionstory.com.au/about/",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".text-body"]
  },
  "mainEntity": {
    "@type": "Person",
    "name": "Dan Neale",
    "jobTitle": "Creative Director",
    "worksFor": { "@type": "Organization", "name": "Motion Story" },
    "knowsAbout": [
      "Motion Design",
      "Creative Direction",
      "Storytelling",
      "Explainer Videos",
      "Product Videos",
      "Storyboarding",
      "SaaS Marketing",
      "Agency Creative Direction"
    ],
    "sameAs": [
      "https://www.linkedin.com/in/danielneale",
      "https://vimeo.com/wearemotionstory"
    ]
  }
};
---

<PageLayout
  title="About Dan Neale | Motion Story"
  description="Meet Dan Neale — the creative director behind Motion Story. 500+ projects since 2012, from the United Nations to TransferWise's first video. Byron Bay."
  activeNav="About"
  ctaHeading="Tell me about the project. I'll tell you what I see."
  floatSubject="About Motion Story"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://motionstory.com.au/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://motionstory.com.au/about/" }
      ]
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="pt-32 pb-24 px-8 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-end">
      <div class="md:col-span-8">
        <span class="text-metadata mb-8 block">About</span>
        <h1 class="font-display text-5xl md:text-8xl font-bold tracking-tight leading-[0.85] mb-10">
          I'm Dan.<br />Motion Story<br />is me.
        </h1>
        <p class="text-body text-lg max-w-md mb-12">
          Creative director. I help companies understand their own product — and build the story around it.
        </p>
        <div class="flex flex-wrap gap-10">
          <a href="/contact/" class="group flex items-center gap-3">
            <span class="text-accent text-2xl">→</span>
            <span class="text-nav-item">Start a project</span>
          </a>
          <a href="#work" class="group flex items-center gap-3">
            <span class="text-accent text-2xl">↓</span>
            <span class="text-nav-item">See the work</span>
          </a>
        </div>
      </div>
      <div class="md:col-span-4">
        <div class="aspect-[4/5] overflow-hidden mb-4">
          <img src="/daniel-neale.jpg" alt="Dan Neale, creative director of Motion Story" class="w-full h-full object-cover" loading="eager" />
        </div>
        <p class="text-metadata">Dan Neale — Byron Bay, Australia</p>
      </div>
    </div>
  </section>

  <!-- Stat strip -->
  <section class="border-y border-black/10">
    <div class="max-w-7xl mx-auto px-8 grid grid-cols-2 md:grid-cols-4">
      <div class="py-10 md:border-r border-black/10">
        <p class="font-display text-2xl md:text-3xl font-bold tracking-tight">2012</p>
        <p class="text-metadata mt-2">Motion Story founded</p>
      </div>
      <div class="py-10 md:border-r border-black/10 md:pl-8">
        <p class="font-display text-2xl md:text-3xl font-bold tracking-tight">500+</p>
        <p class="text-metadata mt-2">Projects delivered</p>
      </div>
      <div class="py-10 md:border-r border-black/10 md:pl-8">
        <p class="font-display text-2xl md:text-3xl font-bold tracking-tight">5.0 <span class="text-accent text-lg align-middle">★</span></p>
        <p class="text-metadata mt-2">{GOOGLE_RATING.count} Google reviews</p>
      </div>
      <div class="py-10 md:pl-8">
        <p class="font-display text-2xl md:text-3xl font-bold tracking-tight">Remote</p>
        <p class="text-metadata mt-2">NYC to NZ, always have</p>
      </div>
    </div>
  </section>

  <!-- 01 The story -->
  <section class="px-8 max-w-7xl mx-auto py-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <div class="md:col-span-4">
        <span class="text-metadata block"><span class="text-accent">01</span> — The story</span>
      </div>
      <div class="md:col-span-7 space-y-8">
        <p class="font-display text-2xl md:text-3xl font-medium tracking-tight leading-snug">
          You brief me, I run the project. No account managers, no juniors animating while a senior name sits on the website.
        </p>
        <p class="text-body text-lg leading-relaxed max-w-xl">
          Making motion since 2010, running Motion Story since 2012. When a job is big I bring in specialists I direct — but nothing gets handed off.
        </p>
        <p class="text-body text-lg leading-relaxed max-w-xl">
          Honest bit: I'm not on social media. I'd rather be working — or outside — than posting about working. People find me through the work. The rest is Byron Bay: father, surfer, big-time animal lover.
        </p>
      </div>
    </div>
  </section>

  <!-- 02 What I actually do -->
  <section class="px-8 max-w-7xl mx-auto pb-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <div class="md:col-span-4">
        <span class="text-metadata block"><span class="text-accent">02</span> — What I actually do</span>
      </div>
      <div class="md:col-span-7">
        <p class="font-display text-2xl md:text-3xl font-medium tracking-tight leading-snug mb-12">
          More than animation. Narrative, story, and strategy — worked out before anyone opens After Effects.
        </p>
        <ul class="space-y-0 border-t border-black/10">
          <li class="py-6 border-b border-black/10 flex gap-6">
            <span class="text-accent shrink-0">→</span>
            <p class="text-body">Product narratives that work everywhere — sales funnels, onboarding, launches, social.</p>
          </li>
          <li class="py-6 border-b border-black/10 flex gap-6">
            <span class="text-accent shrink-0">→</span>
            <p class="text-body">Talk me through a project and I can see the whole thing, finished, while we're still on the call. Then I get it on paper so you see it too.</p>
          </li>
          <li class="py-6 border-b border-black/10 flex gap-6">
            <span class="text-accent shrink-0">→</span>
            <p class="text-body">Concept → storyboard → style → animation. Always that order. A change costs an hour at storyboard, eight once it's animated.</p>
          </li>
          <li class="py-6 border-b border-black/10 flex gap-6">
            <span class="text-accent shrink-0">→</span>
            <p class="text-body">Not just a doer — a creator. The difference between me and a freelancer you hand a script to.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Testimonial strapline — full-bleed black band -->
  <section class="band-black">
    <div class="max-w-7xl mx-auto px-8 py-28">
      <blockquote class="font-display text-3xl md:text-5xl font-bold tracking-tight leading-[1.05] max-w-4xl mb-12">
        “{strapline.quote}”
      </blockquote>
      <div class="flex flex-wrap items-baseline gap-x-6 gap-y-3 mb-16">
        <p class="text-metadata !text-white">{strapline.name} — {strapline.role}, {strapline.company}</p>
        <a href="/reviews/" class="text-metadata !text-white/50 hover:!text-white transition-colors">
          <span class="text-accent">★★★★★</span> {GOOGLE_RATING.score} on Google · All reviews →
        </a>
      </div>
      <p class="font-display text-sm md:text-base font-medium tracking-tight text-white/35">
        United Nations · TransferWise · Amex · Cartier · Atomic · Mosaic · RSPCA · Meltwater · Wipster
      </p>
    </div>
  </section>

  <!-- 03 The work -->
  <section id="work" class="px-8 max-w-7xl mx-auto py-28">
    <div class="flex flex-wrap items-baseline justify-between gap-4 mb-14">
      <span class="text-metadata"><span class="text-accent">03</span> — The work</span>
      <a href="/work/" class="text-metadata hover:text-black transition-colors">Full portfolio →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {aboutWork.map((project) => (
        <a href={`/casestudy/${project.slug}/`} class="group block">
          <div class="aspect-video overflow-hidden bg-black/[0.04] mb-4">
            <img
              src={`https://vumbnail.com/${project.vimeoId}.jpg`}
              alt={project.title}
              class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-[1.02] transition-all duration-700"
              loading="lazy"
            />
          </div>
          <p class="font-display text-base font-medium group-hover:opacity-60 transition-opacity">{project.title}</p>
          <p class="text-metadata opacity-50">{project.client}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- 04 Working with me -->
  <section class="px-8 max-w-7xl mx-auto pb-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <div class="md:col-span-4">
        <span class="text-metadata block"><span class="text-accent">04</span> — Working with me</span>
      </div>
      <div class="md:col-span-7">
        <ul class="space-y-0 border-t border-black/10">
          <li class="py-6 border-b border-black/10 flex gap-6">
            <span class="text-accent shrink-0">→</span>
            <p class="text-body">Send six bullet points, not a twelve-page document. A viewer gives you eight seconds and one idea.</p>
          </li>
          <li class="py-6 border-b border-black/10 flex gap-6">
            <span class="text-accent shrink-0">→</span>
            <p class="text-body">Bring me in early. I'll do the story and storyboard heavy lifting up front.</p>
          </li>
          <li class="py-6 border-b border-black/10 flex gap-6">
            <span class="text-accent shrink-0">→</span>
            <p class="text-body">Agencies: I slot into your team to ideate and build the narrative — creative direction, not just execution. White label or direct.</p>
          </li>
          <li class="py-6 border-b border-black/10 flex gap-6">
            <span class="text-accent shrink-0">→</span>
            <p class="text-body">Big, sprawling, twenty-people-on-a-call jobs aren't my thing. The stylish, well-thought-out, meaningful ones are.</p>
          </li>
          <li class="py-6 border-b border-black/10 flex gap-6">
            <span class="text-accent shrink-0">→</span>
            <p class="text-body">If the brief's wrong, I'll tell you. You're not paying me to nod.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 05 The practical bits -->
  <section class="px-8 max-w-7xl mx-auto pb-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <div class="md:col-span-4">
        <span class="text-metadata block"><span class="text-accent">05</span> — The practical bits</span>
      </div>
      <div class="md:col-span-7">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-10">
          <div>
            <p class="text-metadata mb-3">Cost</p>
            <p class="text-body">From $5,000. Most projects land $10,000–$15,000. Fixed quote upfront.</p>
          </div>
          <div>
            <p class="text-metadata mb-3">Timeline</p>
            <p class="text-body">Most projects take 3–6 weeks from kickoff to delivery.</p>
          </div>
          <div>
            <p class="text-metadata mb-3">Capacity</p>
            <p class="text-body">Limited concurrent projects, on purpose. Get in early.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
