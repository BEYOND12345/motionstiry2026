---
import PageLayout from '../layouts/PageLayout.astro';
import { GOOGLE_RATING, VERIFIED_CLIENT_REVIEWS } from '../data/reviews';
import { getShowcaseProjects } from '../data/projects';
import { PROFILE_LEDE, SITE_DESCRIPTION, WHY_ME } from '../data/site-copy';
import WorkCard from '../components/WorkCard';

const strapline = VERIFIED_CLIENT_REVIEWS[0];
const aboutWork = getShowcaseProjects().slice(0, 3);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Dan Neale | Motion Story",
  "url": "https://motionstory.com.au/about/",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".text-body"]
  },
  "mainEntity": {
    "@type": "Person",
    "name": "Dan Neale",
    "jobTitle": "Motion Designer and Director",
    "worksFor": { "@type": "Organization", "name": "Motion Story" },
    "knowsAbout": [
      "SaaS Motion Graphic Explainer Videos",
      "Motion Graphic Explainer Videos",
      "Motion Graphic Product Explainer Videos",
      "Motion Graphics",
      "Motion Design",
      "Creative Direction",
      "Storytelling",
      "Fintech Motion Graphic Explainer Videos",
      "Cybersecurity Motion Graphic Explainer Videos",
      "Agency Creative Direction"
    ],
    "sameAs": [
      "https://www.linkedin.com/in/danielneale",
      "https://www.behance.net/motion_story",
      "https://dribbble.com/motionstory",
      "https://vimeo.com/wearemotionstory"
    ]
  }
};
---

<PageLayout
  title="About Dan Neale | Motion Story"
  description={SITE_DESCRIPTION}
  activeNav="About"
  showCTA={false}
  floatSubject="About Motion Story"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://motionstory.com.au/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://motionstory.com.au/about/" }
      ]
    })} />
  </Fragment>

  <section class="pt-32 pb-16 md:pb-20 px-8 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-start">
      <div class="md:col-span-8">
        <p class="text-metadata mb-6 md:mb-8">About</p>
        <h1 class="font-display text-5xl md:text-8xl font-bold tracking-tight leading-[0.85] mb-8 md:mb-10">
          I'm Dan.<br /><span class="brand-mark">MotionStory</span><br />is me.
        </h1>
        <p class="text-body text-lg max-w-md mb-10 md:mb-12">
          {PROFILE_LEDE}
        </p>
        <div class="flex flex-wrap items-center gap-5 md:gap-7">
          <a href="/book/" class="ms-btn">Book a call</a>
          <a href="#work" class="ms-link">See the work ↓</a>
        </div>
      </div>
      <div class="md:col-span-4 md:pt-2">
        <div class="w-36 md:w-44">
          <div class="aspect-[4/5] overflow-hidden rounded-xl bg-black/[0.04] mb-3">
            <img
              src="/daniel-neale.jpg"
              alt="Dan Neale, creative director of Motion Story"
              class="w-full h-full object-cover"
              loading="eager"
              width="352"
              height="440"
            />
          </div>
          <p class="font-display text-sm font-medium tracking-tight">Dan Neale</p>
          <p class="text-metadata mt-1 text-black/55">Motion designer &amp; director</p>
        </div>
      </div>
    </div>
  </section>

  <section class="px-8 max-w-7xl mx-auto pb-16 md:pb-20">
    <div class="max-w-2xl space-y-5 md:space-y-6">
      <p class="font-display text-2xl md:text-3xl font-medium tracking-tight leading-snug">
        {WHY_ME.lead}
      </p>
      <p class="text-body text-lg leading-relaxed text-black/70">
        {WHY_ME.body}
      </p>
      <p class="text-body text-lg leading-relaxed text-black/70">
        {WHY_ME.close}
      </p>
      <p class="text-body text-lg leading-relaxed text-black/70">
        Making motion since 2010, Motion Story since 2012. 500+ projects, {GOOGLE_RATING.score} from {GOOGLE_RATING.count} Google reviews, remote from Byron Bay — NYC to NZ, always have. No account managers. When a job is big I bring in specialists I direct, but nothing gets handed off. People find me through the work.
      </p>
      <p class="text-body text-lg leading-relaxed text-black/70">
        Also built <a href="https://smashinvoices.com/" class="border-b border-black/20 hover:border-black transition-colors">SMASH Invoices</a> — a side product for quoting and invoicing by voice on the tools.
      </p>
      <blockquote class="pt-4 md:pt-6">
        <p class="font-display text-xl md:text-2xl font-medium tracking-tight leading-snug mb-4">
          “{strapline.quote}”
        </p>
        <p class="text-metadata text-black/55">
          {strapline.name} — {strapline.role}, {strapline.company}
          <span class="mx-3 opacity-30">·</span>
          <a href="/reviews/" class="border-b border-black/20 hover:border-black transition-colors text-black/55 hover:text-black">All reviews →</a>
        </p>
      </blockquote>
    </div>
  </section>

  <section id="work" class="px-8 max-w-7xl mx-auto py-8 md:py-16">
    <div class="flex flex-wrap items-baseline justify-end gap-4 mb-10 md:mb-14">
      <a href="/work/" class="text-metadata hover:text-black transition-colors">Full portfolio →</a>
    </div>
    <div class="work-grid work-grid-3">
      {aboutWork.map((project, i) => (
        <WorkCard
          client:visible
          vimeoId={project.vimeoId}
          vimeoHash={project.vimeoHash}
          title={project.title}
          client={project.client}
          description={project.description}
          href={`/casestudy/${project.slug}/`}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))}
    </div>
  </section>

  <section class="px-8 max-w-7xl mx-auto pb-24 md:pb-28 pt-8 md:pt-12">
    <div class="max-w-2xl">
      <div class="fold">
        <details class="fold-item">
          <summary>What I actually do</summary>
          <div class="fold-body">
            <ul>
              <li>Product narratives for sales funnels, onboarding, launches, and social.</li>
              <li>Talk me through a project and I can see the whole thing finished — then get it on paper so you see it too.</li>
              <li>Concept → storyboard → style → animation. Always that order.</li>
              <li>Not just a doer — a creator. The difference between me and a freelancer you hand a script to.</li>
            </ul>
          </div>
        </details>
        <details class="fold-item">
          <summary>How I like to work</summary>
          <div class="fold-body">
            <ul>
              <li>Send six bullet points, not a twelve-page document.</li>
              <li>Bring me in early for the story and storyboard.</li>
              <li>Agencies: I slot in for creative direction — white label or direct.</li>
              <li>If the brief’s wrong, I’ll tell you. You’re not paying me to nod.</li>
            </ul>
          </div>
        </details>
        <details class="fold-item">
          <summary>Cost, timeline, capacity</summary>
          <div class="fold-body">
            <ul>
              <li>From $5,000. Most projects land $10,000–$15,000. Fixed quote upfront.</li>
              <li>Most projects take 3–6 weeks from kickoff to delivery. Simpler pieces can ship in 2–4.</li>
              <li>Limited concurrent projects, on purpose. Get in early.</li>
            </ul>
          </div>
        </details>
      </div>
    </div>
  </section>
</PageLayout>
