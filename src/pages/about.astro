---
import PageLayout from '../layouts/PageLayout.astro';
import { getShowcaseProjects } from '../data/projects';
import {
  ABOUT_CLOSE,
  ABOUT_CLOSE_HEADING,
  ABOUT_HEADLINE,
  ABOUT_HELP,
  ABOUT_HELP_HEADING,
  ABOUT_INTRO,
  ABOUT_LEDE,
  ABOUT_SUPPORT,
  SITE_DESCRIPTION,
} from '../data/site-copy';
import WorkCard from '../components/WorkCard';

const aboutWork = getShowcaseProjects();

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Dan Neale | Motion Story",
  "url": "https://motionstory.com.au/about/",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".text-body"]
  },
  "mainEntity": {
    "@type": "Person",
    "name": "Dan Neale",
    "jobTitle": "Motion Designer and Director",
    "worksFor": { "@type": "Organization", "name": "Motion Story" },
    "knowsAbout": [
      "SaaS Motion Graphic Explainer Videos",
      "Motion Graphic Explainer Videos",
      "Motion Graphic Product Explainer Videos",
      "Motion Graphics",
      "Motion Design",
      "Creative Direction",
      "Storytelling",
      "Fintech Motion Graphic Explainer Videos",
      "Cybersecurity Motion Graphic Explainer Videos",
      "Agency Creative Direction"
    ],
    "sameAs": [
      "https://www.linkedin.com/in/danielneale",
      "https://www.behance.net/motion_story",
      "https://dribbble.com/motionstory",
      "https://vimeo.com/wearemotionstory"
    ]
  }
};
---

<PageLayout
  title="About Dan Neale | Motion Story"
  description={SITE_DESCRIPTION}
  activeNav="About"
  showCTA={false}
  floatSubject="About Motion Story"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://motionstory.com.au/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://motionstory.com.au/about/" }
      ]
    })} />
  </Fragment>

  <article class="about-page about-wrap pt-28 pb-28 md:pt-32 md:pb-36">
    <section class="about-hero">
      <h1 class="font-display text-4xl md:text-6xl font-bold tracking-tight leading-[0.92] max-w-3xl">
        {ABOUT_HEADLINE}
      </h1>

      <div class="about-me mt-10 md:mt-12 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16 items-start">
        <div class="md:col-span-3">
          <div class="overflow-hidden rounded-xl bg-black/[0.04] aspect-[4/5] w-28 md:w-full max-w-[12rem]">
            <img
              src="/daniel-neale.jpg"
              alt="Dan Neale, director of Motion Story"
              class="w-full h-full object-cover object-[center_18%]"
              width="240"
              height="300"
            />
          </div>
        </div>
        <div class="md:col-span-7 md:col-start-5 space-y-5 text-body text-lg leading-relaxed max-w-2xl">
          <p>{ABOUT_INTRO}</p>
          {ABOUT_LEDE.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <p class="font-display text-xl font-medium tracking-tight text-black pt-1">
            {ABOUT_SUPPORT}
          </p>
        </div>
      </div>

      <div class="mt-10">
        <a href="/book/" class="ms-btn">Talk to Dan</a>
      </div>
    </section>

    <section class="about-help mt-20 md:mt-24 pt-12 md:pt-14 border-t border-black/10">
      <h2 class="font-display text-xl md:text-2xl font-medium tracking-tight mb-10">
        {ABOUT_HELP_HEADING}
      </h2>
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-10 max-w-4xl">
        {ABOUT_HELP.map((item) => (
          <div class="border-t border-black/10 pt-4">
            <dt class="font-display text-lg font-medium tracking-tight mb-2">{item.label}</dt>
            <dd class="text-body leading-relaxed">{item.line}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="about-close mt-16 md:mt-20 max-w-2xl">
      <h2 class="font-display text-xl md:text-2xl font-medium tracking-tight mb-5">
        {ABOUT_CLOSE_HEADING}
      </h2>
      <div class="space-y-4 text-body text-lg leading-relaxed">
        {ABOUT_CLOSE.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>

    <section id="work" class="about-work mt-20 md:mt-28">
      <div class="about-work-strip">
        {aboutWork.map((project, i) => (
          <WorkCard
            client:visible
            compact
            vimeoId={project.vimeoId}
            vimeoHash={project.vimeoHash}
            title={project.title}
            client={project.client}
            description={project.description}
            href={`/casestudy/${project.slug}/`}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))}
      </div>
      <p class="mt-6">
        <a href="/work/" class="ms-link">Full portfolio →</a>
      </p>
    </section>
  </article>
</PageLayout>

<style>
  .about-wrap {
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .about-work-strip {
    display: flex;
    gap: 0.85rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: none;
  }

  .about-work-strip::-webkit-scrollbar {
    display: none;
  }

  .about-work-strip :global(.work-card) {
    flex: 0 0 min(16.5rem, 72vw);
  }

  @media (min-width: 768px) {
    .about-work-strip :global(.work-card) {
      flex-basis: 18rem;
    }
  }
</style>
