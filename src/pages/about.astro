---
import PageLayout from '../layouts/PageLayout.astro';
import { ALL_PROJECTS } from '../data/projects';
import {
  ABOUT_ARC,
  ABOUT_BUILT_FOR,
  ABOUT_CASES,
  ABOUT_HEADLINE,
  ABOUT_LEDE,
  ABOUT_MESSY,
  ABOUT_MODES,
  ABOUT_PLUG,
  ABOUT_STEPS,
  ABOUT_SUPPORT,
  SITE_DESCRIPTION,
} from '../data/site-copy';
import { VERTICAL_TICKER_A, VERTICAL_TICKER_B } from '../data/vertical-landings/helpers';
import ClientTicker from '../components/ClientTicker';
import VimeoEmbed from '../components/VimeoEmbed';
import { vimeoPosterUrl } from '../lib/vimeo';

const hero = ALL_PROJECTS.find((p) => p.id === 'trudi')!;
const cases = ABOUT_CASES.map((entry) => {
  const project = ALL_PROJECTS.find((p) => p.id === entry.id);
  if (!project) throw new Error(`Unknown about case: ${entry.id}`);
  return { ...entry, project };
});

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Dan Neale | Motion Story",
  "url": "https://motionstory.com.au/about/",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".text-body"]
  },
  "mainEntity": {
    "@type": "Person",
    "name": "Dan Neale",
    "jobTitle": "Motion Designer and Director",
    "worksFor": { "@type": "Organization", "name": "Motion Story" },
    "knowsAbout": [
      "SaaS Motion Graphic Explainer Videos",
      "Motion Graphic Explainer Videos",
      "Motion Graphic Product Explainer Videos",
      "Motion Graphics",
      "Motion Design",
      "Creative Direction",
      "Storytelling",
      "Fintech Motion Graphic Explainer Videos",
      "Cybersecurity Motion Graphic Explainer Videos",
      "Agency Creative Direction"
    ],
    "sameAs": [
      "https://www.linkedin.com/in/danielneale",
      "https://www.behance.net/motion_story",
      "https://dribbble.com/motionstory",
      "https://vimeo.com/wearemotionstory"
    ]
  }
};
---

<PageLayout
  title="About Dan Neale | Motion Story"
  description={SITE_DESCRIPTION}
  activeNav="About"
  showCTA={false}
  floatSubject="About Motion Story"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://motionstory.com.au/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://motionstory.com.au/about/" }
      ]
    })} />
  </Fragment>

  <div class="about-page">
    <section class="about-wrap pt-32 pb-20 md:pt-36 md:pb-28">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-end">
        <div class="md:col-span-6">
          <h1 class="font-display text-4xl md:text-6xl font-bold tracking-tight leading-[0.92] mb-8 md:mb-10">
            {ABOUT_HEADLINE}
          </h1>
          <p class="text-body text-lg max-w-md mb-6">
            {ABOUT_LEDE}
          </p>
          <p class="text-metadata text-black/50 mb-10">{ABOUT_SUPPORT}</p>
          <div class="flex flex-wrap items-center gap-5 md:gap-7">
            <a href="#work" class="ms-link">See the work →</a>
            <a href="/book/" class="ms-btn">Talk to Dan</a>
          </div>
        </div>
        <div class="md:col-span-6">
          <div class="about-hero-film rounded-xl overflow-hidden bg-black/[0.04]">
            <img
              class="about-hero-still"
              src={vimeoPosterUrl(hero.vimeoId)}
              alt=""
              width="1280"
              height="720"
            />
            <iframe
              class="about-hero-loop"
              src={`https://player.vimeo.com/video/${hero.vimeoId}?background=1&autoplay=1&muted=1&loop=1&title=0&byline=0&portrait=0`}
              title={hero.title}
              allow="autoplay; fullscreen"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="about-wrap pb-20 md:pb-28">
      <h2 class="font-display text-3xl md:text-5xl font-medium tracking-tight leading-[1.05] max-w-4xl mb-8">
        Think of Motion Story as an extension of your team.
      </h2>
      <p class="text-body text-lg leading-relaxed text-black/70 max-w-2xl mb-6">
        Sometimes you need a complete production studio. Sometimes you just need someone who can crack the idea, storyboard it and help your team figure out how to communicate it.
      </p>
      <p class="text-body text-lg leading-relaxed text-black/70 max-w-2xl mb-16">
        I can plug in wherever the project needs me — working alongside your marketing, product or creative team, or taking the whole thing from first conversation to finished film.
      </p>
      <p class="font-display text-xl md:text-2xl font-medium tracking-tight leading-snug max-w-2xl mb-4">
        You don't need another freelancer. You need someone who can understand the product, challenge the idea, work with your team and take responsibility for getting the thing made.
      </p>
      <p class="font-display text-xl md:text-2xl font-medium tracking-tight leading-snug max-w-2xl mb-14">
        {ABOUT_BUILT_FOR}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-14">
        {ABOUT_MODES.map((mode) => (
          <div class="border-t border-black/15 pt-5">
            <p class="font-display text-2xl font-medium tracking-tight mb-3">{mode.label}</p>
            <p class="text-body text-black/60">{mode.line}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="about-ink py-20 md:py-28 mb-20 md:mb-28">
      <div class="about-wrap">
        <h2 class="font-display text-3xl md:text-5xl font-medium tracking-tight leading-[1.05] max-w-3xl mb-14 md:mb-16">
          Big-studio capability. Without the big-studio layers.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 mb-16">
          <div>
            <p class="text-metadata text-white/40 mb-4">The studio experience</p>
            <p class="text-lg leading-relaxed text-white/75">
              I've spent years working at the level of large creative and production studios, delivering complex motion and visual communication for major brands and technology companies.
            </p>
          </div>
          <div>
            <p class="text-metadata text-white/40 mb-4">The relationship</p>
            <p class="text-lg leading-relaxed text-white/75">
              Today, you work directly with me. No account manager between us. No handing the project off to someone you've never met. I lead the thinking, creative direction and production — and bring in trusted specialists when a project needs them.
            </p>
          </div>
        </div>
        <p class="font-display text-2xl md:text-3xl font-medium tracking-tight">
          Small by design. Capable by experience.
        </p>
      </div>
    </section>

    <section class="about-wrap pb-20 md:pb-28">
      <h2 class="font-display text-3xl md:text-5xl font-medium tracking-tight leading-[1.05] max-w-3xl mb-8">
        The animation comes last. The thinking comes first.
      </h2>
      <p class="text-body text-lg leading-relaxed text-black/70 max-w-2xl mb-5">
        I'm obsessive about ideas, story and storyboarding. Before we start animating, I want to know exactly what we're trying to communicate, who needs to understand it and why they'll care.
      </p>
      <p class="text-body text-lg leading-relaxed text-black/70 max-w-2xl mb-14">
        I'll challenge the brief if I think there's a better way to tell the story. Because beautiful animation can't rescue a confusing idea.
      </p>
      <ol class="max-w-xl space-y-0 mb-16">
        {ABOUT_STEPS.map((step, i) => (
          <li>
            <p class="flex gap-5 items-baseline py-4 border-t border-black/10">
              <span class="text-metadata text-accent shrink-0">0{i + 1}</span>
              <span class="font-display text-xl md:text-2xl font-medium tracking-tight">{step}</span>
            </p>
          </li>
        ))}
      </ol>
      <p class="text-metadata text-black/40">{ABOUT_ARC.join(' → ')}</p>
    </section>

    <section class="about-wrap pb-20 md:pb-28">
      <h2 class="font-display text-3xl md:text-5xl font-medium tracking-tight leading-[1.05] max-w-3xl mb-14">
        Bring me in wherever the project needs me.
      </h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-10 md:gap-y-14">
        {ABOUT_PLUG.map((item) => (
          <li class="border-t border-black/10 pt-5">
            <p class="font-display text-xl md:text-2xl font-medium tracking-tight mb-3">{item.label}</p>
            <p class="text-body text-lg leading-relaxed text-black/65">{item.line}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-wrap pb-20 md:pb-28">
      <h2 class="font-display text-4xl md:text-6xl font-bold tracking-tight leading-[0.92] max-w-3xl mb-10">
        You don't need to have it figured out.
      </h2>
      <p class="font-display text-2xl md:text-3xl font-medium tracking-tight mb-10">
        Send me the messy version.
      </p>
      <ul class="flex flex-wrap gap-x-6 gap-y-3 max-w-2xl mb-10">
        {ABOUT_MESSY.map((item) => (
          <li class="text-body text-lg text-black/70">{item}</li>
        ))}
      </ul>
      <p class="text-body text-lg leading-relaxed text-black/70 max-w-xl mb-10">
        I'll help work out what matters, find the story and turn it into something people can actually understand.
      </p>
      <p class="font-display text-xl md:text-2xl font-medium tracking-tight">
        You bring the complicated thing. I'll help make sense of it.
      </p>
    </section>

    <section id="work" class="about-wrap pb-20 md:pb-28">
      <h2 class="font-display text-3xl md:text-5xl font-medium tracking-tight leading-[1.05] max-w-3xl mb-4">
        Some complicated things I've made clear.
      </h2>
      <p class="text-body text-lg text-black/60 max-w-xl mb-14">
        This isn't theoretical. This is the kind of work I already do.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-14">
        {cases.map((item, i) => (
          <article>
            <VimeoEmbed
              client:visible
              vimeoId={item.project.vimeoId}
              vimeoHash={item.project.vimeoHash}
              title={item.project.title}
              loading={i < 2 ? 'eager' : 'lazy'}
              className="rounded-xl mb-5"
            />
            <p class="text-metadata mb-4">{item.project.client}</p>
            <dl class="space-y-2.5">
              <div>
                <dt class="text-metadata text-black/40 mb-0.5">The problem</dt>
                <dd class="text-body text-[0.95rem] leading-relaxed text-black/70">{item.problem}</dd>
              </div>
              <div>
                <dt class="text-metadata text-black/40 mb-0.5">What I did</dt>
                <dd class="text-body text-[0.95rem] leading-relaxed text-black/70">{item.did}</dd>
              </div>
              <div>
                <dt class="text-metadata text-black/40 mb-0.5">The result</dt>
                <dd class="text-body text-[0.95rem] leading-relaxed text-black">{item.result}</dd>
              </div>
            </dl>
            <a href={`/casestudy/${item.project.slug}/`} class="ms-link inline-block mt-4">The film →</a>
          </article>
        ))}
      </div>
      <p class="mt-12">
        <a href="/work/" class="ms-link">Full portfolio →</a>
      </p>
    </section>

    <section class="about-wrap pb-20 md:pb-28">
      <ClientTicker
        client:load
        label=""
        rowA={VERTICAL_TICKER_A}
        rowB={VERTICAL_TICKER_B}
        compact
      />
    </section>

    <section class="about-wrap pb-20 md:pb-28">
      <h2 class="font-display text-3xl md:text-5xl font-medium tracking-tight leading-[1.05] max-w-3xl mb-8">
        The relationship can grow with the product.
      </h2>
      <p class="text-body text-lg leading-relaxed text-black/70 max-w-2xl mb-6">
        One project becomes a product launch. Then a feature demo. Then a sales video. Then a campaign. Then something the CEO needs next week.
      </p>
      <p class="text-body text-lg leading-relaxed text-black/70 max-w-2xl mb-10">
        That's why I like working with technology companies over time. I get to understand the product properly, and your team gets a creative partner who already understands how you work.
      </p>
      <p class="font-display text-2xl md:text-3xl font-medium tracking-tight max-w-xl">
        You don't need to brief a new studio every time. You can just call me.
      </p>
    </section>

    <section class="about-wrap pb-20 md:pb-28">
      <h2 class="font-display text-3xl md:text-5xl font-medium tracking-tight leading-[1.05] max-w-3xl mb-8">
        And agencies can plug me in too.
      </h2>
      <p class="text-body text-lg leading-relaxed text-black/70 max-w-2xl mb-6">
        If you're an agency without a dedicated motion team, I can work behind the scenes as your specialist studio.
      </p>
      <p class="text-body text-lg leading-relaxed text-black/70 max-w-2xl mb-10">
        You can bring me into the project when a client needs motion, animation, product storytelling or visualisation — and I can work within your creative direction, or help develop the idea with you. You get the capability of a specialist motion studio without building one yourself.
      </p>
      <p class="font-display text-xl md:text-2xl font-medium tracking-tight">
        Your client. Your relationship. My production capability.
      </p>
    </section>

    <section class="about-wrap pb-20 md:pb-28">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 items-start">
        <div class="md:col-span-4">
          <div class="overflow-hidden rounded-xl bg-black/[0.04] aspect-[4/5] max-w-[16rem] md:max-w-none">
            <img
              src="/daniel-neale.jpg"
              alt="Dan Neale, director of Motion Story"
              class="w-full h-full object-cover object-[center_18%]"
              loading="lazy"
              width="480"
              height="600"
            />
          </div>
        </div>
        <div class="md:col-span-7 md:col-start-6">
          <h2 class="font-display text-3xl md:text-4xl font-medium tracking-tight leading-snug mb-8">
            I'm Dan. Motion Story is deliberately small.
          </h2>
          <div class="space-y-5 text-body text-lg leading-relaxed text-black/70 max-w-xl">
            <p>I've been working in motion graphics and visual storytelling for most of my career. I built and ran a larger studio, working on the kind of projects you'd expect from a big production company.</p>
            <p>Over time I realised I preferred being closer to the work — closer to the ideas, the clients and the actual problem we were trying to solve.</p>
            <p>So Motion Story is built differently. It's small, senior and hands-on. You work directly with me. I bring the experience of the bigger studios, but without the layers that come with them.</p>
            <p class="font-display text-xl font-medium tracking-tight text-black pt-2">I like complicated things.</p>
            <p>Technology, systems, products, ideas that don't fit neatly into a sentence. The harder something is to explain, the more interesting the problem becomes.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="about-wrap pb-24 md:pb-32">
      <h2 class="font-display text-4xl md:text-6xl font-bold tracking-tight leading-[0.92] max-w-3xl mb-6">
        Got something complicated to explain?
      </h2>
      <p class="font-display text-2xl md:text-3xl font-medium tracking-tight mb-10">
        Send me the messy version.
      </p>
      <div class="flex flex-wrap items-center gap-5 md:gap-7 mb-10">
        <a href="/book/" class="ms-btn">Talk to Dan</a>
        <a href="#work" class="ms-link">See the work →</a>
      </div>
      <p class="text-metadata text-black/45">
        Motion Story — Creative direction, design and animation for complex technology.
      </p>
    </section>
  </div>
</PageLayout>

<style>
  .about-wrap {
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .about-hero-film {
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .about-hero-loop,
  .about-hero-still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .about-hero-still {
    display: block;
  }

  .about-hero-loop {
    z-index: 1;
  }

  .about-ink {
    background: #0a0a0a;
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-hero-loop {
      display: none;
    }
  }
</style>
