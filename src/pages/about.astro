---
import PageLayout from '../layouts/PageLayout.astro';
import { VERIFIED_CLIENT_REVIEWS } from '../data/reviews';
import { getShowcaseProjects } from '../data/projects';
import { ABOUT_HELP, ABOUT_HIRE, ABOUT_LEDE, SITE_DESCRIPTION, WHY_ME } from '../data/site-copy';
import { VERTICAL_TICKER_A, VERTICAL_TICKER_B } from '../data/vertical-landings/helpers';
import WorkCard from '../components/WorkCard';
import ClientTicker from '../components/ClientTicker';

const aboutWork = getShowcaseProjects().slice(0, 3);
const acodis = VERIFIED_CLIENT_REVIEWS.find((r) => r.company === 'Acodis')!;

const testimonials = [
  acodis,
  {
    quote: 'There are a lot of motion designers out there but not many who think like Dan does.',
    name: 'Troy Cornelius',
    company: '',
  },
  {
    quote: '62% completion. 21% view rate. For a video about bins.',
    name: 'Lee Bright',
    company: 'Method Recycling',
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Dan Neale | Motion Story",
  "url": "https://motionstory.com.au/about/",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".text-body"]
  },
  "mainEntity": {
    "@type": "Person",
    "name": "Dan Neale",
    "jobTitle": "Motion Designer and Director",
    "worksFor": { "@type": "Organization", "name": "Motion Story" },
    "knowsAbout": [
      "SaaS Motion Graphic Explainer Videos",
      "Motion Graphic Explainer Videos",
      "Motion Graphic Product Explainer Videos",
      "Motion Graphics",
      "Motion Design",
      "Creative Direction",
      "Storytelling",
      "Fintech Motion Graphic Explainer Videos",
      "Cybersecurity Motion Graphic Explainer Videos",
      "Agency Creative Direction"
    ],
    "sameAs": [
      "https://www.linkedin.com/in/danielneale",
      "https://www.behance.net/motion_story",
      "https://dribbble.com/motionstory",
      "https://vimeo.com/wearemotionstory"
    ]
  }
};
---

<PageLayout
  title="About Dan Neale | Motion Story"
  description={SITE_DESCRIPTION}
  activeNav="About"
  showCTA={false}
  floatSubject="About Motion Story"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://motionstory.com.au/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://motionstory.com.au/about/" }
      ]
    })} />
  </Fragment>

  <section class="pt-32 pb-20 md:pb-24 px-8 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 items-start">
      <div class="md:col-span-8">
        <p class="text-metadata mb-6 md:mb-8">About</p>
        <h1 class="font-display text-5xl md:text-7xl font-bold tracking-tight leading-[0.88] mb-8 md:mb-10">
          I'm Dan.<br /><span class="brand-mark">MotionStory</span><br />is me.
        </h1>
        <p class="text-body text-lg max-w-md mb-8 md:mb-10">
          {ABOUT_LEDE}
        </p>
        <div class="flex flex-wrap items-center gap-5 md:gap-7">
          <a href="/book/" class="ms-btn">Book a call</a>
          <a href="#work" class="ms-link">See the work ↓</a>
        </div>
      </div>
      <div class="md:col-span-4 md:justify-self-end md:pt-10">
        <div class="w-20 md:w-[6.5rem]">
          <div class="overflow-hidden rounded-xl bg-black/[0.04] aspect-[4/5]">
            <img
              src="/daniel-neale.jpg"
              alt="Dan Neale, director and consultant at Motion Story"
              class="w-full h-full object-cover object-[center_18%]"
              loading="eager"
              width="416"
              height="520"
            />
          </div>
          <p class="font-display text-sm font-medium tracking-tight mt-4">Dan Neale</p>
          <p class="text-metadata mt-1 text-black/55 whitespace-nowrap">Byron Bay</p>
        </div>
      </div>
    </div>
  </section>

  <section class="px-8 max-w-7xl mx-auto pb-20 md:pb-28">
    <ClientTicker
      client:load
      label=""
      rowA={VERTICAL_TICKER_A}
      rowB={VERTICAL_TICKER_B}
      compact
    />
  </section>

  <section class="px-8 max-w-7xl mx-auto pb-20 md:pb-28 border-t border-black/5 pt-16 md:pt-20">
    <p class="text-metadata mb-6">The pitch</p>
    <h2 class="font-display text-2xl md:text-4xl font-medium tracking-tight leading-snug max-w-3xl mb-8">
      {WHY_ME.lead}
    </h2>
    <p class="text-body text-lg leading-relaxed text-black/70 max-w-2xl">
      I've built my own products, including <a href="https://smashinvoices.com/" class="border-b border-black/20 hover:border-black transition-colors">SMASH Invoices</a>. I know what it feels like when the thing is good and nobody can explain it yet. I work with tech. I use AI when it enables the idea — never as a substitute for one.
    </p>
  </section>

  <section class="px-8 max-w-7xl mx-auto pb-20 md:pb-28 border-t border-black/5 pt-16 md:pt-20">
    <h2 class="text-metadata mb-10 md:mb-14">How I can help</h2>
    <ul class="max-w-3xl">
      {ABOUT_HELP.map((item) => (
        <li class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-8 py-5 md:py-6 border-b border-black/10 first:pt-0 last:border-b-0">
          <span class="md:col-span-5 font-display text-xl md:text-2xl font-medium tracking-tight">
            {item.label}
          </span>
          <span class="md:col-span-7 text-body text-lg text-black/65 leading-relaxed">
            {item.line}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="px-8 max-w-7xl mx-auto pb-20 md:pb-28 border-t border-black/5 pt-16 md:pt-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16">
      <div class="md:col-span-5">
        <h2 class="text-metadata mb-8">Why hire me</h2>
        <ul class="space-y-6 mb-10">
          {ABOUT_HIRE.map((line) => (
            <li class="flex gap-4 items-start">
              <span class="text-accent leading-none mt-1.5 shrink-0" aria-hidden="true">·</span>
              <span class="font-display text-xl font-medium tracking-tight leading-snug">{line}</span>
            </li>
          ))}
        </ul>
        <a href="/book/" class="ms-btn">Book a call</a>
      </div>
      <div class="md:col-span-6 md:col-start-7">
        <h2 class="text-metadata mb-8">How I work with you</h2>
        <p class="font-display text-xl font-medium tracking-tight leading-snug mb-4">Startups</p>
        <p class="text-body text-lg leading-relaxed text-black/70 mb-10">
          Bring me in like a consultant. I sit with founders and product, find the story, and turn the project around.
        </p>
        <p class="font-display text-xl font-medium tracking-tight leading-snug mb-4">Agencies</p>
        <p class="text-body text-lg leading-relaxed text-black/70">
          White label or collaborative. I slot into your team and own the craft — your client still has one point of contact.
        </p>
      </div>
    </div>
  </section>

  <section class="px-8 max-w-7xl mx-auto pb-20 md:pb-28 border-t border-black/5 pt-16 md:pt-20">
    <div class="flex flex-wrap items-baseline justify-between gap-4 mb-10 md:mb-14">
      <h2 class="text-metadata">What they say</h2>
      <a href="/reviews/" class="text-metadata hover:text-black transition-colors">All reviews →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16">
      {testimonials.map((t) => (
        <blockquote>
          <p class="font-display text-xl font-medium tracking-tight leading-snug mb-5">
            “{t.quote}”
          </p>
          <footer class="text-metadata text-black/55">
            {t.name}{t.company ? <><span class="mx-2 opacity-30">·</span>{t.company}</> : null}
          </footer>
        </blockquote>
      ))}
    </div>
  </section>

  <section id="work" class="px-8 max-w-7xl mx-auto pb-20 md:pb-28 border-t border-black/5 pt-16 md:pt-20">
    <div class="flex flex-wrap items-baseline justify-between gap-4 mb-10 md:mb-14">
      <h2 class="font-display text-2xl md:text-3xl font-medium tracking-tight">A few films</h2>
      <a href="/work/" class="text-metadata hover:text-black transition-colors">Full portfolio →</a>
    </div>
    <div class="work-grid work-grid-3">
      {aboutWork.map((project, i) => (
        <WorkCard
          client:visible
          vimeoId={project.vimeoId}
          vimeoHash={project.vimeoHash}
          title={project.title}
          client={project.client}
          description={project.description}
          href={`/casestudy/${project.slug}/`}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))}
    </div>
  </section>

  <section class="px-8 max-w-7xl mx-auto pb-24 md:pb-32 pt-8 md:pt-12">
    <div class="max-w-xl">
      <p class="font-display text-3xl md:text-4xl font-medium tracking-tight leading-snug mb-8">
        I'm the right person for the job.
      </p>
      <a href="/book/" class="ms-btn">Book a call</a>
    </div>
  </section>
</PageLayout>
