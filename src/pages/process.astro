---
import PageLayout from '../layouts/PageLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "How I Work | Motion Design Process | Motion Story",
  "url": "https://motionstory.com.au/process/",
  "description": "The process that turns complex briefs into clear motion design. Three phases. No wasted time. Dan Neale, Motion Story.",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".text-body"]
  }
};

const faqs = [
  {
    q: "How much does a project cost?",
    a: "From $5,000. Most projects land around $10,000–$15,000 — that's the range I prefer to work in. Fixed quote upfront after we understand the brief — no cookie-cutter packages.",
  },
  {
    q: "How long does a typical motion design project take?",
    a: "Most projects run 3 to 6 weeks from kickoff to final delivery. Phase one (script and concept) usually takes about a week. Phase two (storyboard and style frames) takes about 1 to 2 weeks. Phase three (animation, sound, revisions) takes another 1 to 3 weeks. Tight timelines are possible for simpler pieces — I'll always be upfront about what's realistic and what's not.",
  },
  {
    q: "Why work with a small studio instead of a big production house?",
    a: "You skip the account manager and producer layers and work directly with me — the creative director. Small studio, big impact: senior craft, faster decisions, and one person accountable for the story from brief to delivery. Best fit for SaaS teams, startups, and agencies that want a fractional creative partner rather than a large production pipeline. For problem-solving sessions that lead to the build: https://motionstory.com.au/creative-business-designer/",
  },
  {
    q: "Do you offer creative business designer sessions?",
    a: "Yes. A paid problem-solving session, then I build the thing: website, video, prototype, or funnel. Details: https://motionstory.com.au/creative-business-designer/",
  },
  {
    q: "How many rounds of revisions do I get?",
    a: "Two structured revision rounds during animation, plus one structured review after storyboard and style frames. The structure matters: feedback is consolidated, not drip-fed, so the project keeps momentum. Scope changes mid-project are handled transparently — if they push timeline or cost, you'll know before any work starts.",
  },
  {
    q: "What do I need to provide to get started?",
    a: "Not a script. Just context. Who are you, who are you trying to reach, what do you want them to do next, and what's getting in the way right now. If you have a brand guide, existing decks, screenshots, or competitor references, those help. If you don't, we build the brief together in phase one.",
  },
  {
    q: "Who will I actually be working with?",
    a: "Me. Daniel Neale. I own the concept, the storyboard, the creative direction, and the delivery — and I respond to your feedback directly. When a job needs extra hands, I bring in specialists I trust and direct. No account managers. That end-to-end ownership is the model.",
  },
  {
    q: "Can you work to a fixed deadline?",
    a: "Yes, if the timeline is realistic for the scope. I'll be honest early in the conversation about whether a date is achievable. If it's tight, we can sometimes reduce scope (shorter runtime, simpler visual direction, fewer revisions) to hit the date without cutting corners on the things that matter.",
  },
  {
    q: "Do you offer ongoing motion design or retainer work?",
    a: "Yes. A lot of SaaS and product-led clients work with me on a rolling basis — a series of feature videos, social cutdowns, quarterly updates, or ongoing campaign motion. After the first project ships, we can set up a lightweight retainer or book work project-by-project, whichever suits. For paid problem-solving sessions that lead to a build, see Creative Business Designer: https://motionstory.com.au/creative-business-designer/",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<PageLayout
  title="How I Work | Motion Design Process | Motion Story"
  description="The process that turns complex briefs into clear motion design. Three phases. From $5,000. Dan Neale, Motion Story."
  activeNav="Process"
  ctaHeading="You don't need a video. You need people to understand what you do."
  floatSubject="Motion design process"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://motionstory.com.au/" },
        { "@type": "ListItem", "position": 2, "name": "Process", "item": "https://motionstory.com.au/process/" }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="pt-32 pb-24 px-8 max-w-5xl mx-auto">
    <span class="text-metadata mb-8 block">Process</span>
    <h1 class="font-display text-4xl md:text-8xl font-bold tracking-tight leading-[0.85] mb-16">
      The process isn't<br />complicated. The<br />clarity is.
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-20">
      <div>
        <p class="text-body text-lg leading-relaxed">
          Most projects fail before a single frame is animated. The brief is wrong. The message is buried. There's no clear point of view. Here's how I stop that from happening.
        </p>
      </div>
    </div>

    <p class="text-metadata mb-32 max-w-xl">
      A change costs an hour at storyboard — and eight hours once it's animated. That’s why the order never changes.
    </p>

    <!-- Phases — short heads, detail folded -->
    <div class="space-y-16 mb-28">
      <section>
        <span class="text-metadata mb-4 block text-accent">01</span>
        <h2 class="font-display text-3xl font-bold tracking-tight mb-6">Challenge the brief.</h2>
        <p class="text-body text-lg leading-relaxed max-w-2xl mb-8">
          Before visuals: what does this piece need to do, who watches it, and what decision do they make afterwards.
        </p>
        <div class="fold max-w-2xl">
          <details class="fold-item">
            <summary>What happens in this phase</summary>
            <div class="fold-body">
              <ul>
                <li>Discovery session: me asking hard questions</li>
                <li>Script and concept: one clear direction, not three options</li>
                <li>Voice and tone direction</li>
                <li>Visual style reference</li>
              </ul>
            </div>
          </details>
        </div>
      </section>

      <section>
        <span class="text-metadata mb-4 block text-accent">02</span>
        <h2 class="font-display text-3xl font-bold tracking-tight mb-6">Build the visual argument.</h2>
        <p class="text-body text-lg leading-relaxed max-w-2xl mb-8">
          One clear visual direction, agreed early — before animation makes changes expensive.
        </p>
        <div class="fold max-w-2xl">
          <details class="fold-item">
            <summary>What gets built</summary>
            <div class="fold-body">
              <ul>
                <li>Storyboard (rough → refined)</li>
                <li>Style frame design</li>
                <li>Motion direction: how things move, not just how they look</li>
                <li>One structured feedback round before production</li>
              </ul>
            </div>
          </details>
        </div>
      </section>

      <section>
        <span class="text-metadata mb-4 block text-accent">03</span>
        <h2 class="font-display text-3xl font-bold tracking-tight mb-6">Animate. Refine. Ship.</h2>
        <p class="text-body text-lg leading-relaxed max-w-2xl mb-8">
          Production moves fast when the earlier phases did their job.
        </p>
        <div class="fold max-w-2xl">
          <details class="fold-item">
            <summary>What gets delivered</summary>
            <div class="fold-body">
              <ul>
                <li>Full animation production</li>
                <li>Sound design and voiceover integration</li>
                <li>Two structured revision rounds</li>
                <li>Final delivery in your required formats</li>
              </ul>
            </div>
          </details>
        </div>
      </section>
    </div>

    <!-- FAQ — folded -->
    <section class="mb-16">
      <span class="text-metadata mb-8 block">Questions</span>
      <div class="fold">
        {faqs.map((faq) => (
          <details class="fold-item">
            <summary>{faq.q}</summary>
            <div class="fold-body">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

  </div>
</PageLayout>
