---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpineLandingPage from '../components/LandingPage/SpineLandingPage';
import EmailFloat from '../components/EmailFloat.astro';
import Footer from '../components/Footer.astro';
import { explainerVideoLanding } from '../data/landing-pages/explainer-video';
import '../styles/global.css';

const config = explainerVideoLanding;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Product Videos for SaaS',
  description: config.seo.metaDescription,
  provider: { '@type': 'Organization', name: 'Motion Story', url: 'https://motionstory.com.au' },
  serviceType: 'Product video production',
  areaServed: 'Worldwide',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: config.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout
  title={config.seo.titleTag}
  description={config.seo.metaDescription}
  canonicalUrl={`https://motionstory.com.au${config.seo.canonicalPath}`}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    {config.faq.items.length > 0 ? (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    ) : null}
    <!-- TODO(dan): Replace with live GA4 + Google Ads IDs -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
    </script>
  </Fragment>

  <SpineLandingPage client:load config={config} />
  <Footer />
  <EmailFloat />
</BaseLayout>
