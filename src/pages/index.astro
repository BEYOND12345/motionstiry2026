---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Homepage from '../components/Homepage';
import EmailFloat from '../components/EmailFloat.astro';
import { SITE_DESCRIPTION, SITE_DESCRIPTION_LONG, SITE_TITLE } from '../data/site-copy';
import '../styles/global.css';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LocalBusiness"],
      "@id": "https://motionstory.com.au/#organization",
      "name": "Motion Story",
      "alternateName": "Motion Story Studio",
      "url": "https://motionstory.com.au",
      "logo": "https://motionstory.com.au/logo.png",
      "description": SITE_DESCRIPTION_LONG,
      "foundingDate": "2010",
      "founder": {
        "@type": "Person",
        "name": "Daniel Neale",
        "jobTitle": "Founder & Creative Director"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Unit 2 - 17 Tasman Way",
        "addressLocality": "Byron Bay",
        "addressRegion": "NSW",
        "postalCode": "2481",
        "addressCountry": "AU"
      },
      "email": "daniel@motionstory.com.au",
      "priceRange": "$$$$",
      "areaServed": [
        { "@type": "Country", "name": "Australia" },
        { "@type": "Place", "name": "Worldwide" }
      ],
      "knowsAbout": [
        "SaaS Motion Graphic Explainer Videos",
        "Motion Graphic Explainer Videos",
        "Motion Graphic Product Explainer Videos",
        "Fintech Motion Graphic Explainer Videos",
        "Cybersecurity Motion Graphic Explainer Videos",
        "Motion Graphics",
        "Motion Design",
        "Creative Direction",
        "Product Demo Videos",
        "Agency Creative Direction"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Motion Design Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Motion Graphic Product Explainer Videos",
              "description": "Show the software in action. Motion graphic product explainer videos — more than a screen recording."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "SaaS Motion Graphic Explainer Videos",
              "description": "SaaS motion graphic explainer videos for new products. Product on screen, story first."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Onboarding Animation",
              "description": "Get users to value faster, reduce churn. Animated onboarding sequences that accelerate product activation."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Campaign Motion",
              "description": "Short-form motion design for LinkedIn, paid ads, pre-roll, and social campaigns."
            }
          }
        ]
      },
      "sameAs": [
        "https://www.instagram.com/motionstory",
        "https://vimeo.com/wearemotionstory",
        "https://www.linkedin.com/company/studiomotionstory",
        "https://www.linkedin.com/in/danielneale",
        "https://www.behance.net/motion_story",
        "https://dribbble.com/motionstory"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://motionstory.com.au/#website",
      "url": "https://motionstory.com.au",
      "name": "Motion Story",
      "publisher": { "@id": "https://motionstory.com.au/#organization" }
    },
    {
      "@type": "WebPage",
      "@id": "https://motionstory.com.au/#webpage",
      "url": "https://motionstory.com.au",
      "name": "Motion Story — SaaS Motion Graphic Explainer Videos | Byron Bay",
      "description": SITE_DESCRIPTION,
      "isPartOf": { "@id": "https://motionstory.com.au/#website" },
      "about": { "@id": "https://motionstory.com.au/#organization" },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", ".text-body"]
      }
    }
  ]
};
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  bodyClass="homepage-layout"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Nav />
  <Homepage client:load />
  <EmailFloat subject="Project enquiry" />
</BaseLayout>
