---
import PageLayout from '../layouts/PageLayout.astro';
import PortfolioPage from '../components/PortfolioPage';

const workDescription =
  "Motion graphics portfolio for startups, SaaS, agencies, and tech brands. Complex ideas made clear.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Motion Graphics Portfolio — Motion Story",
  "description": workDescription,
  "url": "https://motionstory.com.au/work/",
  "isPartOf": {
    "@type": "WebSite",
    "name": "Motion Story",
    "url": "https://motionstory.com.au"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Motion Story",
    "url": "https://motionstory.com.au"
  }
};
---

<PageLayout
  title="Motion Graphics Portfolio | Motion Story"
  description={workDescription}
  activeNav="Work"
  ctaHeading="Got something complex to explain?"
  floatSubject="Portfolio enquiry"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://motionstory.com.au/" },
        { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://motionstory.com.au/work/" }
      ]
    })} />
  </Fragment>

  <PortfolioPage client:load />
</PageLayout>
