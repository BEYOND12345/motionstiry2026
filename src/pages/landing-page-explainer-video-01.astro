---
import PageLayout from '../layouts/PageLayout.astro';
import SpineLandingPage from '../components/LandingPage/SpineLandingPage';
import { explainerVideoLanding } from '../data/landing-pages/explainer-video';
import '../styles/global.css';

const config = explainerVideoLanding;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Product Videos for SaaS',
  description: config.seo.metaDescription,
  provider: { '@type': 'Organization', name: 'Motion Story', url: 'https://motionstory.com.au' },
  serviceType: 'Product video production',
  areaServed: 'Worldwide',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: config.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<PageLayout
  title={config.seo.titleTag}
  description={config.seo.metaDescription}
  canonicalUrl={`https://motionstory.com.au${config.seo.canonicalPath}`}
  showCTA={false}
  floatSubject="Explainer video"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    {config.faq.items.length > 0 ? (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    ) : null}
    <!-- TODO(dan): Replace with live GA4 + Google Ads IDs -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      // gtag('js', new Date());
      // gtag('config', 'G-XXXXXXXX');
      // gtag('config', 'AW-XXXXXXXX');
    </script>
  </Fragment>

  <SpineLandingPage client:load config={config} />
</PageLayout>
