---
import PageLayout from '../layouts/PageLayout.astro';
import VerticalLanding from '../components/VerticalLanding.astro';
import { motionGraphicsVerticalLanding } from '../data/vertical-landings/motion-graphics';

const config = motionGraphicsVerticalLanding;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Freelance Motion Designer',
  description: config.seo.metaDescription,
  provider: {
    '@type': 'Person',
    name: 'Daniel Neale',
    jobTitle: 'Freelance motion designer',
    url: 'https://motionstory.com.au/about/',
    worksFor: { '@type': 'Organization', name: 'Motion Story', url: 'https://motionstory.com.au' },
  },
  serviceType: 'Motion Graphics',
  areaServed: ['Australia', 'Worldwide'],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://motionstory.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Motion Graphics', item: 'https://motionstory.com.au/motion-graphics/' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: config.faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<PageLayout
  title={config.seo.titleTag}
  description={config.seo.metaDescription}
  canonicalUrl={`https://motionstory.com.au${config.seo.canonicalPath}`}
  floatSubject="Motion graphics brief"
  ctaHeading="Book a 15-minute brief call."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <VerticalLanding config={config} />
</PageLayout>
