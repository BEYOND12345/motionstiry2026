---
import PageLayout from '../layouts/PageLayout.astro';
import ServiceLanding from '../components/ServiceLanding.astro';

/** Work set restored from the archived /start-up-explainer-videos/ page. */
const work = [
  { title: "ARK / Product Concept", link: "/casestudy/ark-product-concept/", vimeoId: "818912051" },
  { title: "Cart-share / Startup Explainer", link: "/casestudy/cart-share-explainer/", vimeoId: "792094835" },
  { title: "Ranalytic / RF Scanner", link: "/casestudy/ranalytic-rf-scanner/", vimeoId: "759713697" },
  { title: "Trulet / AI Property Management", link: "/casestudy/trulet-property/", vimeoId: "341479251" },
  { title: "Joineree / Marketplace Recruitment", link: "/casestudy/joineree-recruitment-explainer/", vimeoId: "338133495" },
  { title: "Bat Nav / Big Battery Power", link: "/casestudy/bat-nav-platform-explainer/", vimeoId: "479992275" },
];

const moreWork = [
  { title: "Trusyft / Product Promo", link: "/casestudy/trusyft-animated-product-promo/", vimeoId: "863428533" },
  { title: "Hey You / Food Ordering App", link: "/casestudy/heyyou-app/", vimeoId: "351936883" },
  { title: "Good2Pay / Paperless Invoicing", link: "/casestudy/good2pay/", vimeoId: "448704979" },
  { title: "Food By Us / Kitchen Ordering", link: "/casestudy/food-by-us/", vimeoId: "672120018" },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Start-Up Explainer Videos",
  "description": "Explainer and product video for startups. Launch stories that help people understand what you do and trust you to do it.",
  "provider": { "@type": "Organization", "name": "Motion Story", "url": "https://motionstory.com.au" },
  "serviceType": "Start-Up Explainer Videos",
  "areaServed": "Worldwide",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://motionstory.com.au/" },
    { "@type": "ListItem", "position": 2, "name": "Startups", "item": "https://motionstory.com.au/startups/" },
  ],
};
---

<PageLayout
  floatSubject="Startup explainer video"
  title="Stories for Startups | Start-Up Explainer Videos | Motion Story"
  description="Whether you're disrupting a marketplace or creating a new one, people need to understand what you do. Startup explainer videos by Dan Neale, Motion Story."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <ServiceLanding
    eyebrow="Startups"
    headline={["Stories for", "startups."]}
    lede="Whether you're disrupting a marketplace or creating a whole new one, you need people to understand what you do and trust you to do it well. With a dynamic visual story, you can connect with investors, show the value your product brings, and clarify doubts about the next big idea."
    work={work}
    moreWork={moreWork}
    quote="62% completion rate. 21% view rate. Long-term asset for our business."
    quoteBy="Lee Bright"
    quoteRole="Marketing Lead, Method Recycling"
    faqs={[
      { label: "Convince & scale", body: "Get customers believing in what you're doing. Convince more investors to back your idea. Reinforce your brand and convey your character." },
      { label: "Cost", body: "From $5,000. Most projects land around $10,000–$15,000. Fixed quote upfront." },
      { label: "Fit for startups", body: "Homepage heroes, waitlist videos, investor updates, and the first product story that has to work cold." },
      { label: "How we work", body: "You work with Dan throughout — concept, storyboard, design, illustration, and animation. Agencies welcome, white label or direct." },
    ]}
    relatedReading={[
      { href: "/creative-business-designer/", label: "Creative business designer" },
      { href: "/how-explainer-videos-supercharge-startup-growth/", label: "How explainer videos drive startup growth" },
      { href: "/motion-design-in-pitch-deck-what-investors-want/", label: "Motion design in pitch decks" },
      { href: "/how-much-does-saas-motion-design-video-cost/", label: "What motion design videos cost" },
    ]}
    links={[
      { href: "/creative-business-designer/", eyebrow: "Sessions", label: "Creative business designer →" },
      { href: "/saas-explainer-videos/", eyebrow: "SaaS", label: "SaaS explainer videos →" },
      { href: "/product-demo-videos/", eyebrow: "Demos", label: "Product demo videos →" },
      { href: "/work/", eyebrow: "Work", label: "See all work →" },
    ]}
  />
</PageLayout>
