---
import PageLayout from '../layouts/PageLayout.astro';
import VerticalLanding from '../components/VerticalLanding.astro';
import { causesVerticalLanding } from '../data/vertical-landings/causes';

const config = causesVerticalLanding;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Charity & Nonprofit Explainer Videos',
  description: config.seo.metaDescription,
  provider: { '@type': 'Organization', name: 'Motion Story', url: 'https://motionstory.com.au' },
  serviceType: 'Motion Design for Nonprofits and Government',
  areaServed: 'Worldwide',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://motionstory.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Causes & Nonprofits', item: 'https://motionstory.com.au/causes/' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: config.faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<PageLayout
  title={config.seo.titleTag}
  description={config.seo.metaDescription}
  canonicalUrl={`https://motionstory.com.au${config.seo.canonicalPath}`}
  floatSubject="Cause explainer video"
  ctaHeading="Clarify your mission story in minutes."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <VerticalLanding config={config} />
</PageLayout>
