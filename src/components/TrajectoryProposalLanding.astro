---
/**
 * Private Trajectory proposal.
 * One clear spine: Plan → Why → Work → Investment → Close.
 * Stages are the visual centerpiece. Other sections support, not compete.
 */
import VimeoEmbed from './VimeoEmbed';
import { trajectoryProposal as c } from '../data/sales-pages/trajectory';
---

<div class="tp">
  <!-- COVER -->
  <header class="tp-cover">
    <p class="tp-eyebrow">For Arjun · Trajectory</p>
    <div class="tp-cover-grid">
      <div class="tp-cover-copy">
        <h1 class="tp-title">{c.greeting}</h1>
        <p class="tp-intro">{c.lede}</p>
        <nav class="tp-toc" aria-label="On this page">
          <a href="#plan">The plan</a>
          <a href="#why">Why me</a>
          <a href="#work">Work</a>
          <a href="#investment">Investment</a>
        </nav>
      </div>
      <aside class="tp-cover-aside">
        <div class="tp-photo">
          <img
            src="/daniel-neale.jpg"
            alt="Dan Neale"
            width="480"
            height="600"
            loading="eager"
          />
        </div>
        <p class="tp-photo-name">{c.portraitCaption}</p>
        <p class="tp-photo-role">{c.portraitRole}</p>
      </aside>
    </div>
  </header>

  <!-- PLAN: stages + complexity as one chapter -->
  <section id="plan" class="tp-chapter tp-plan">
    <div class="tp-chapter-intro">
      <p class="tp-eyebrow">{c.stagesEyebrow}</p>
      <h2 class="tp-chapter-title">{c.stagesHeadline}</h2>
      <p class="tp-chapter-lede">{c.stagesLede}</p>
    </div>

    <ol class="tp-stages">
      {
        c.stages.map((stage, i) => (
          <li class="tp-stage" style={`--i: ${i}`}>
            <span class="tp-stage-num" aria-hidden="true">{stage.num}</span>
            <div class="tp-stage-copy">
              <h3 class="tp-stage-title">{stage.title}</h3>
              <p class="tp-stage-body">{stage.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="tp-ladder">
      <div class="tp-ladder-head">
        <p class="tp-eyebrow">{c.scaleEyebrow}</p>
        <h3 class="tp-ladder-title">{c.scaleHeadline}</h3>
        <p class="tp-ladder-lede">{c.scaleLede}</p>
      </div>
      <ol class="tp-ladder-track">
        {
          c.scaleLevels.map((item, i) => (
            <li class="tp-ladder-step" style={`--i: ${i}`}>
              <span class="tp-ladder-mark">{item.level}</span>
              <span class="tp-ladder-label">{item.label}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- WHY -->
  <section id="why" class="tp-chapter tp-why">
    <div class="tp-chapter-intro">
      <p class="tp-eyebrow">{c.whyEyebrow}</p>
      <h2 class="tp-chapter-title">{c.whyHeadline}</h2>
    </div>
    <ul class="tp-why-list">
      {
        c.whyPoints.map((point) => (
          <li class="tp-why-item">
            <h3 class="tp-why-title">{point.title}</h3>
            <p class="tp-why-body">{point.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- WORK -->
  <section id="work" class="tp-chapter tp-work">
    <div class="tp-chapter-intro">
      <p class="tp-eyebrow">{c.workEyebrow}</p>
      <h2 class="tp-chapter-title">{c.workHeadline}</h2>
      <p class="tp-chapter-lede">{c.workLede}</p>
    </div>
    <div class="tp-films">
      {
        c.work.map((piece) =>
          piece.kind === 'film' ? (
            <article class="tp-film">
              <VimeoEmbed
                client:visible
                vimeoId={piece.vimeoId}
                title={piece.client}
                loading="lazy"
                autoColor={true}
                className="rounded-xl"
              />
              <div class="tp-film-meta">
                <p class="tp-film-cat">{piece.category}</p>
                <h3 class="tp-film-client">{piece.client}</h3>
                <a href={piece.link} class="tp-text-link">Case study</a>
              </div>
            </article>
          ) : null
        )
      }
    </div>
  </section>

  <!-- INVESTMENT -->
  <section id="investment" class="tp-chapter tp-invest">
    <div class="tp-chapter-intro">
      <p class="tp-eyebrow">{c.pricingEyebrow}</p>
      <h2 class="tp-chapter-title">{c.pricingHeadline}</h2>
      <p class="tp-chapter-lede">{c.pricingLede}</p>
    </div>

    <div class="tp-rate-block">
      <p class="tp-rate">{c.hourly.rate}</p>
      <p class="tp-rate-note">{c.hourly.note}</p>
    </div>

    <ul class="tp-ranges">
      {
        c.ranges.map((range) => (
          <li class="tp-range">
            <h3 class="tp-range-title">{range.title}</h3>
            <p class="tp-range-body">{range.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="tp-extras">
      <div class="tp-extra">
        <h3 class="tp-extra-title">Brand motion kit</h3>
        <p class="tp-extra-body">{c.kitNote}</p>
      </div>
      <div class="tp-extra">
        <h3 class="tp-extra-title">Ongoing retainer</h3>
        <p class="tp-extra-body">{c.retainerNote}</p>
      </div>
    </div>
  </section>

  <!-- CLOSE -->
  <section class="tp-close" aria-labelledby="tp-close-title">
    <h2 id="tp-close-title" class="tp-close-title">{c.closeHeadline}</h2>
    <p class="tp-close-lede">{c.closeLede}</p>
    <div class="tp-close-actions">
      <a href={c.closeMailto} class="ms-btn">{c.closeCta}</a>
      <a href="/book/" class="tp-text-link">Or book a short call</a>
    </div>
  </section>
</div>

<style>
  .tp {
    --ink: #0a0a0a;
    --mute: #505050;
    --faint: #6e6e6e;
    --line: rgba(10, 10, 10, 0.1);
    --red: #ff0000;
    --pad: 1.5rem;
    --max: 70rem;
    box-sizing: border-box;
    max-width: var(--max);
    margin: 0 auto;
    padding: 6.5rem var(--pad) 5rem;
    color: var(--ink);
  }

  .tp *,
  .tp *::before,
  .tp *::after {
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .tp {
      --pad: 2.5rem;
      padding: 8rem var(--pad) 6.5rem;
    }
  }

  .tp-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red);
    margin: 0 0 1rem;
  }

  /* ——— COVER ——— */
  .tp-cover {
    padding-bottom: 4rem;
    margin-bottom: 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 768px) {
    .tp-cover {
      padding-bottom: 5rem;
    }
  }

  .tp-cover-grid {
    display: grid;
    gap: 2.5rem;
    margin-top: 0.25rem;
  }

  @media (min-width: 800px) {
    .tp-cover-grid {
      grid-template-columns: minmax(0, 1fr) 11rem;
      gap: 4rem;
      align-items: end;
    }
  }

  .tp-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin: 0 0 1.35rem;
    text-wrap: balance;
  }

  .tp-intro {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.55;
    color: var(--mute);
    max-width: 32rem;
    margin: 0 0 2rem;
  }

  .tp-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.5rem;
  }

  .tp-toc a {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--faint);
    border-bottom: 1px solid transparent;
    padding-bottom: 0.1rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .tp-toc a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .tp-cover-aside {
    width: 8rem;
  }

  @media (min-width: 800px) {
    .tp-cover-aside {
      width: 11rem;
      justify-self: end;
    }
  }

  .tp-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0.75rem;
    background: rgba(10, 10, 10, 0.04);
    margin-bottom: 0.85rem;
  }

  .tp-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tp-photo-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    margin: 0 0 0.25rem;
  }

  .tp-photo-role {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0;
  }

  /* ——— CHAPTER SHELL ——— */
  .tp-chapter {
    padding: 4.5rem 0 0;
    scroll-margin-top: 6rem;
  }

  @media (min-width: 768px) {
    .tp-chapter {
      padding: 5.75rem 0 0;
    }
  }

  .tp-chapter-intro {
    max-width: 36rem;
    margin-bottom: 2.75rem;
  }

  @media (min-width: 768px) {
    .tp-chapter-intro {
      margin-bottom: 3.5rem;
    }
  }

  .tp-chapter-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 0.9rem;
    text-wrap: balance;
  }

  .tp-chapter-lede {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--mute);
    margin: 0;
    max-width: 34rem;
  }

  /* ——— STAGES (centerpiece) ——— */
  .tp-stages {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .tp-stage {
    display: grid;
    gap: 0.75rem 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(14px);
    animation: tp-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.1s + var(--i) * 0.12s);
  }

  @media (min-width: 768px) {
    .tp-stage {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: 2rem 3rem;
      padding: 2.75rem 0;
      align-items: start;
    }
  }

  .tp-stage-num {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.85;
    color: var(--red);
  }

  .tp-stage-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 0.75rem;
  }

  .tp-stage-body {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--mute);
    margin: 0;
    max-width: 36rem;
  }

  /* Complexity ladder — nested under plan, quieter */
  .tp-ladder {
    margin-top: 3.5rem;
    padding: 2.5rem 0 0;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 768px) {
    .tp-ladder {
      margin-top: 4.25rem;
      padding-top: 3rem;
    }
  }

  .tp-ladder-head {
    max-width: 34rem;
    margin-bottom: 1.75rem;
  }

  .tp-ladder-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 0.55rem;
  }

  .tp-ladder-lede {
    font-family: var(--font-sans);
    font-size: 0.9875rem;
    line-height: 1.55;
    color: var(--mute);
    margin: 0;
  }

  .tp-ladder-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    position: relative;
  }

  @media (min-width: 900px) {
    .tp-ladder-track {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0 1rem;
      padding-top: 1.5rem;
    }

    .tp-ladder-track::before {
      content: '';
      position: absolute;
      top: 0.35rem;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, rgba(255, 0, 0, 0.25), var(--red));
      border-radius: 999px;
    }
  }

  .tp-ladder-step {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .tp-ladder-step {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      padding: 0;
      border-bottom: none;
      position: relative;
    }

    .tp-ladder-step::before {
      content: '';
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 999px;
      background: var(--red);
      position: absolute;
      top: -1.3rem;
      left: 0;
      box-shadow: 0 0 0 4px #fff;
    }
  }

  .tp-ladder-mark {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
  }

  .tp-ladder-label {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  /* ——— WHY ——— */
  .tp-why {
    border-top: 1px solid var(--line);
    margin-top: 4.5rem;
  }

  @media (min-width: 768px) {
    .tp-why {
      margin-top: 5.75rem;
    }
  }

  .tp-why-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem 3rem;
  }

  @media (min-width: 768px) {
    .tp-why-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .tp-why-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 0 0 0.5rem;
  }

  .tp-why-body {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--mute);
    margin: 0;
    max-width: 28rem;
  }

  /* ——— WORK ——— */
  .tp-work {
    border-top: 1px solid var(--line);
    margin-top: 4.5rem;
  }

  @media (min-width: 768px) {
    .tp-work {
      margin-top: 5.75rem;
    }
  }

  .tp-films {
    display: grid;
    gap: 2.5rem 1.5rem;
  }

  @media (min-width: 700px) {
    .tp-films {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .tp-films {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.75rem 1.5rem;
    }
  }

  .tp-film-meta {
    margin-top: 0.9rem;
  }

  .tp-film-cat {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 0.35rem;
  }

  .tp-film-client {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.45rem;
  }

  .tp-text-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--mute);
    border-bottom: 1px solid rgba(10, 10, 10, 0.2);
    padding-bottom: 0.1rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .tp-text-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  /* ——— INVESTMENT ——— */
  .tp-invest {
    border-top: 1px solid var(--line);
    margin-top: 4.5rem;
  }

  @media (min-width: 768px) {
    .tp-invest {
      margin-top: 5.75rem;
    }
  }

  .tp-rate-block {
    padding: 2rem 0;
    margin-bottom: 2.5rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .tp-rate {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0 0 0.85rem;
  }

  .tp-rate-note {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--mute);
    margin: 0;
    max-width: 34rem;
  }

  .tp-ranges {
    list-style: none;
    margin: 0 0 2.75rem;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .tp-ranges {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .tp-range-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.45rem;
  }

  .tp-range-body {
    font-family: var(--font-sans);
    font-size: 0.9875rem;
    line-height: 1.55;
    color: var(--mute);
    margin: 0;
  }

  .tp-extras {
    display: grid;
    gap: 1.75rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 768px) {
    .tp-extras {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .tp-extra-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.45rem;
  }

  .tp-extra-body {
    font-family: var(--font-sans);
    font-size: 0.9875rem;
    line-height: 1.55;
    color: var(--mute);
    margin: 0;
  }

  /* ——— CLOSE ——— */
  .tp-close {
    margin-top: 4.5rem;
    padding: 3rem 0 0;
    border-top: 2px solid var(--ink);
    max-width: 34rem;
    scroll-margin-top: 6rem;
  }

  @media (min-width: 768px) {
    .tp-close {
      margin-top: 5.75rem;
      padding-top: 3.5rem;
    }
  }

  .tp-close-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 0.9rem;
  }

  .tp-close-lede {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--mute);
    margin: 0 0 1.75rem;
  }

  .tp-close-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }

  @keyframes tp-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tp-stage {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
