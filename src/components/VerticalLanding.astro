---
/**
 * Landing template — claim, ticker, work with proof woven through, a few questions.
 * Shared nav/footer via PageLayout. Ads/sales pages stay on their own skins.
 */
import VimeoEmbed from './VimeoEmbed';
import WorkCard from './WorkCard';
import ClientTicker from './ClientTicker';
import type { VerticalLandingConfig } from '../data/vertical-landings/types';

interface Props {
  config: VerticalLandingConfig;
}

const { config } = Astro.props;
const cases = config.cases;
const whyLines = config.benefits.items.slice(0, 3);
const faqs = config.faqs.slice(0, 4);
---

<div class="vl">
  <header class="vl-hero">
    <div class="vl-hero-copy">
      <p class="vl-eyebrow">{config.eyebrow}</p>
      <h1 class="vl-title">
        {config.headline.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h1>
      <p class="vl-lede">{config.lede}</p>
      <div class="vl-hero-cta">
        <a href="/book/" class="ms-btn">Book a call</a>
        <a href="#work" class="ms-link">See the work</a>
      </div>
    </div>
    <div class="vl-hero-film">
      <VimeoEmbed
        client:load
        vimeoId={config.heroVideo.vimeoId}
        vimeoHash={config.heroVideo.vimeoHash}
        title={config.heroVideo.title}
        loading="eager"
        autoColor={true}
        className="rounded-xl"
      />
    </div>
  </header>

  <section class="vl-ticker" aria-label={config.tickerLabel ?? 'Clients'}>
    <ClientTicker
      client:load
      label={config.tickerLabel ?? 'Clients'}
      rowA={config.tickerRowA}
      rowB={config.tickerRowB}
      compact
    />
  </section>

  <section id="work" class="vl-work">
    <p class="vl-work-intro">{config.value.headline}</p>

    <div class="work-grid">
      {cases.slice(0, 2).map((study, i) => (
        <WorkCard
          client:visible
          vimeoId={study.vimeoId}
          vimeoHash={study.vimeoHash}
          title={study.title}
          client={study.client}
          description={study.body}
          href={study.link}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))}

      <blockquote class="work-grid-break vl-break">
        <p>“{config.quote.text}”</p>
        <footer>
          {config.quote.name}
          <span> — {config.quote.role}</span>
        </footer>
      </blockquote>

      {cases.slice(2, 4).map((study) => (
        <WorkCard
          client:visible
          vimeoId={study.vimeoId}
          vimeoHash={study.vimeoHash}
          title={study.title}
          client={study.client}
          description={study.body}
          href={study.link}
        />
      ))}

      <ul class="work-grid-break vl-break-lines">
        {whyLines.map((item) => (
          <li>
            <span class="text-accent" aria-hidden="true">→</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>

      {cases.slice(4).map((study) => (
        <WorkCard
          client:visible
          vimeoId={study.vimeoId}
          vimeoHash={study.vimeoHash}
          title={study.title}
          client={study.client}
          description={study.body}
          href={study.link}
        />
      ))}
    </div>

    <p class="vl-all-work">
      <a href="/work/">See the full portfolio →</a>
    </p>
  </section>

  <section class="vl-faq">
    <h2 class="vl-section-title">Questions</h2>
    <div class="fold">
      {faqs.map((faq) => (
        <details class="fold-item">
          <summary>{faq.question}</summary>
          <div class="fold-body">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  {config.links.length > 0 && (
    <section class="vl-more">
      <h2 class="vl-section-title">More work</h2>
      <nav class="vl-links" aria-label="More work">
        {config.links.map((link) => (
          <a href={link.href} class="vl-link-card">
            <span class="vl-eyebrow">{link.eyebrow}</span>
            <p>{link.label}</p>
          </a>
        ))}
      </nav>
    </section>
  )}
</div>

<style>
  .vl {
    max-width: 80rem;
    margin: 0 auto;
    padding: 8.5rem 2rem 6rem;
  }

  @media (min-width: 768px) {
    .vl {
      padding: 9.5rem 2rem 8rem;
    }
  }

  .vl-eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7a7a7a;
    line-height: 1.4;
    margin: 0;
  }

  .vl-hero {
    display: grid;
    gap: 2rem;
    margin-bottom: 3rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .vl-hero {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      gap: 3rem;
      margin-bottom: 3.5rem;
    }
  }

  .vl-hero-copy {
    max-width: 34rem;
  }

  .vl-hero-film {
    min-width: 0;
  }

  .vl-title {
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 5.6vw, 4.15rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 1.25rem 0 1.5rem;
    color: var(--color-fg);
    text-wrap: balance;
  }

  .vl-lede {
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #555;
    margin: 0 0 1.75rem;
  }

  .vl-hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }

  .vl-ticker {
    margin: 0 -0.25rem 3.5rem;
    padding: 1.5rem 12rem 1.5rem 0;
    border-top: 1px solid rgba(10, 10, 10, 0.1);
    border-bottom: 1px solid rgba(10, 10, 10, 0.1);
  }

  @media (max-width: 767px) {
    .vl-ticker {
      padding-right: 8.5rem;
    }
  }

  .vl-work-intro,
  .vl-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 2.5rem;
    max-width: 28rem;
  }

  .vl-break {
    padding: 0.25rem 0 0.5rem;
    margin: 0;
  }

  .vl-break p {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin: 0 0 0.85rem;
    max-width: 40rem;
  }

  .vl-break footer {
    font-size: 0.8125rem;
    color: #7a7a7a;
  }

  .vl-break-lines {
    list-style: none;
    padding: 0.5rem 0 0.75rem;
    margin: 0;
    display: grid;
    gap: 1.15rem 2rem;
  }

  @media (min-width: 768px) {
    .vl-break-lines {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .vl-break-lines li {
    display: flex;
    gap: 0.65rem;
    font-size: 0.9875rem;
    line-height: 1.45;
    color: #333;
  }

  .vl-all-work {
    margin: 3rem 0 0;
    font-size: 0.875rem;
  }

  .vl-all-work a {
    border-bottom: 1px solid rgba(10, 10, 10, 0.2);
    padding-bottom: 0.15rem;
  }

  .vl-all-work a:hover {
    border-color: #0a0a0a;
  }

  .vl-faq {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(10, 10, 10, 0.1);
  }

  .vl-more {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(10, 10, 10, 0.1);
  }

  .vl-links {
    display: grid;
    gap: 1px;
    background: rgba(10, 10, 10, 0.08);
  }

  @media (min-width: 700px) {
    .vl-links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .vl-link-card {
    display: block;
    background: #fff;
    padding: 1.75rem 0 1.75rem 0;
    transition: opacity 0.2s ease;
  }

  @media (min-width: 700px) {
    .vl-link-card {
      padding: 2rem 1.5rem 2rem 0;
    }

    .vl-link-card:nth-child(even) {
      padding-left: 1.5rem;
    }
  }

  .vl-link-card:hover {
    opacity: 0.7;
  }

  .vl-link-card .vl-eyebrow {
    margin-bottom: 0.75rem;
  }

  .vl-link-card p {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }
</style>
