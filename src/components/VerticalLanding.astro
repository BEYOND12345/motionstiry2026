---
/**
 * Landing template — claim, ticker, work with proof woven through, a few questions.
 * Shared nav/footer via PageLayout. Ads/sales pages stay on their own skins.
 */
import VimeoEmbed from './VimeoEmbed';
import HeroFilmCarousel from './HeroFilmCarousel';
import WorkCard from './WorkCard';
import ClientTicker from './ClientTicker';
import type { VerticalLandingConfig } from '../data/vertical-landings/types';

interface Props {
  config: VerticalLandingConfig;
}

const { config } = Astro.props;
const cases = config.cases;
const workLed = Boolean(config.workLed);
const storyLed = Boolean(config.storyLed && config.story);
const story = config.story;
const weaves = config.weaves ?? [];
const whyLines = config.benefits.items.slice(0, 3);
const faqs = config.faqs.slice(0, 4);

function weaveLines(text?: string | string[]) {
  if (!text) return [];
  return (Array.isArray(text) ? text : [text]).filter(Boolean).slice(0, 3);
}

function markedTitle(text: string, phrase?: string) {
  if (!phrase || !text.includes(phrase)) return text;
  const at = text.indexOf(phrase);
  return { before: text.slice(0, at), mark: phrase, after: text.slice(at + phrase.length) };
}

function titleLines(value: string | string[]) {
  return Array.isArray(value) ? value : [value];
}

const ledeParas = Array.isArray(config.lede) ? config.lede : [config.lede];
const meParas = Array.isArray(config.value.body)
  ? config.value.body
  : [config.value.body || (Array.isArray(config.lede) ? config.lede[0] : config.lede)];
const meTitle = workLed && meParas[0]?.startsWith('Hi,') ? meParas[0] : '';
const meBody = meTitle ? meParas.slice(1) : meParas;
const closeParas = config.ctaNote
  ? Array.isArray(config.ctaNote)
    ? config.ctaNote
    : [config.ctaNote]
  : [];
const gridWeaves = weaves.filter((item) => item.after < cases.length);
const endWeaves = weaves.filter((item) => item.after >= cases.length);
const lastGridAfter = gridWeaves.reduce((max, weave) => Math.max(max, weave.after), 0);
const workIntroTitle = config.workIntro?.headline
  ? markedTitle(config.workIntro.headline, config.workIntro.mark)
  : '';
const closeTitle = story?.close
  ? markedTitle(story.close.headline, story.close.mark)
  : '';
const showMe = !storyLed && !config.hideMe && meBody.length > 0;
const heroFilms = (config.heroCarousel ?? []).filter((film) => film.vimeoId);
const useHeroCarousel = heroFilms.length > 1;

/** Short hero labels. The config eyebrow stays the longer SEO string and is not printed. */
const heroLabels: Record<string, string> = {
  '/explainer-videos/': 'Explainer',
  '/saas-explainer-videos/': 'SaaS',
  '/product-demo-videos/': 'Product demo',
  '/freelance-motion-graphic-designer/': 'Freelance',
  '/finance-explainer-videos/': 'Finance',
  '/startups/': 'Startups',
  '/product-launch-video/': 'Launch',
  '/agencies/': 'Agencies',
  '/technology-videos/': 'Technology',
  '/causes/': 'Causes',
  '/cybersecurity-explainer-videos/': 'Cybersecurity',
  '/animation-production-company/': 'Animation',
};
const heroLabel = heroLabels[config.seo.canonicalPath] ?? '';

/** Space Grotesk 700 advance widths, thousandths of an em. */
const grotesk700: Record<string, number> = {
  A: 634, B: 664, C: 644, D: 666, E: 554, F: 534, G: 662, H: 656, I: 264, J: 610,
  K: 626, L: 542, M: 882, N: 670, O: 676, P: 604, Q: 676, R: 632, S: 606, T: 588,
  U: 672, V: 618, W: 898, X: 644, Y: 624, Z: 576, a: 578, b: 638, c: 586, d: 638,
  e: 577, f: 436, g: 638, h: 616, i: 266, j: 268, k: 564, l: 266, m: 854, n: 616,
  o: 612, p: 638, q: 638, r: 396, s: 524, t: 456, u: 616, v: 548, w: 784, x: 592,
  y: 616, z: 518, '0': 648, '1': 452, '2': 594, '3': 608, '4': 636, '5': 600,
  '6': 618, '7': 554, '8': 600, '9': 618, '.': 298, '&': 591, "'": 294,
};

function wordEms(word: string) {
  let sum = 0;
  for (const ch of word) sum += grotesk700[ch] ?? 700;
  return sum / 1000 - 0.025 * Math.max(0, word.length - 1);
}

const heroWordEms = config.headline
  .join(' ')
  .split(/\s+/)
  .filter(Boolean)
  .reduce((max, word) => Math.max(max, wordEms(word)), 1)
  .toFixed(3);
---

<div class="vl">
  <header class="vl-hero">
    <div class="vl-hero-copy">
      {heroLabel ? <span class="text-metadata vl-kicker">{heroLabel}</span> : null}
      <h1 class="vl-title" style={`--vl-ems: ${heroWordEms}`}>
        {config.headline.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h1>
      <div class="vl-lede">
        {ledeParas.map((para) => (
          <p>{para}</p>
        ))}
      </div>
      <div class="vl-hero-cta">
        <a href="/book/" class="ms-btn">Book a call</a>
      </div>
    </div>
    <div class={`vl-hero-film${useHeroCarousel ? " has-reel" : ""}`}>
      {useHeroCarousel ? (
        <HeroFilmCarousel client:load films={heroFilms} />
      ) : (
        <VimeoEmbed
          client:load
          vimeoId={config.heroVideo.vimeoId}
          vimeoHash={config.heroVideo.vimeoHash}
          title={config.heroVideo.title}
          loading="eager"
          autoColor={true}
          className="rounded-xl"
        />
      )}
    </div>
  </header>

  <section class="vl-ticker" aria-label={config.tickerLabel ?? 'Clients'}>
    <ClientTicker
      client:load
      label=""
      rowA={config.tickerRowA}
      rowB={config.tickerRowB}
      compact
    />
  </section>

  {storyLed && story ? (
    <>
      {story.idea ? (
      <section class="vl-band">
        <div class="vl-band-copy">
          <h2 class="vl-band-title">
            {titleLines(story.idea.headline).map((line, i) => {
              const marked = markedTitle(line, story.idea.mark);
              return (
                <>
                  {i > 0 && <br />}
                  {typeof marked === 'string' ? (
                    marked
                  ) : (
                    <>{marked.before}<span class="spine-mark">{marked.mark}</span>{marked.after}</>
                  )}
                </>
              );
            })}
          </h2>
          {weaveLines(story.idea.text).map((line) => (
            <p class="spine-break-copy">{line}</p>
          ))}
        </div>
        <div class="vl-band-film">
          <VimeoEmbed
            client:visible
            vimeoId={story.idea.film.vimeoId}
            vimeoHash={story.idea.film.vimeoHash}
            title={story.idea.film.title}
            className="rounded-xl"
          />
        </div>
      </section>
      ) : null}

      <section class="vl-band vl-band-quote">
        <blockquote>
          <p class="vl-quote-stage">“{story.quote.text}”</p>
          <footer>
            {story.quote.role
              ? `${story.quote.name}, ${story.quote.role}`
              : story.quote.name}
          </footer>
        </blockquote>
      </section>

      <section class="vl-band vl-band-range">
        <div class="vl-band-copy">
          <h2 class="vl-band-title">
            {titleLines(story.range.headline).map((line, i) => {
              const marked = markedTitle(line, story.range.mark);
              return (
                <>
                  {i > 0 && <br />}
                  {typeof marked === 'string' ? (
                    marked
                  ) : (
                    <>{marked.before}<span class="spine-mark">{marked.mark}</span>{marked.after}</>
                  )}
                </>
              );
            })}
          </h2>
          {weaveLines(story.range.text).map((line) => (
            <p class="spine-break-copy">{line}</p>
          ))}
        </div>
        <div class="vl-range-films">
          {story.range.films.map((study) => (
            <WorkCard
              client:visible
              vimeoId={study.vimeoId}
              vimeoHash={study.vimeoHash}
              title={study.title}
              client={study.client}
              description={study.body}
              href={study.link}
            />
          ))}
        </div>
      </section>

      {cases.length > 0 ? (
        <section id="work" class="vl-work vl-work-more">
          <div class="work-grid spine-work-led">
            {cases.map((study) => (
              <WorkCard
                client:visible
                vimeoId={study.vimeoId}
                vimeoHash={study.vimeoHash}
                title={study.title}
                client={study.client}
                description={study.body}
                href={study.link}
              />
            ))}
          </div>
        </section>
      ) : null}

      <div class="vl-end vl-band-close vl-close-with-me">
        <img
          src="/daniel-neale.jpg"
          alt="Dan Neale"
          width="72"
          height="72"
          class="dan-photo dan-photo-md"
        />
        <p class="spine-break-title vl-close-title">
          {typeof closeTitle === 'string' ? (
            closeTitle
          ) : (
            <>{closeTitle.before}<span class="spine-mark">{closeTitle.mark}</span>{closeTitle.after}</>
          )}
        </p>
        <div class="vl-close-body">
          {weaveLines(story.close.text).map((line) => (
            <p class="spine-break-copy">{line}</p>
          ))}
        </div>
        <div class="vl-close-action">
          <a href="/book/" class="ms-btn">
            {story.close.ctaLabel}
          </a>
        </div>
      </div>
    </>
  ) : null}

  {showMe ? (
    <section class="vl-me">
      <img
        src="/daniel-neale.jpg"
        alt="Dan Neale"
        width="72"
        height="72"
        class="dan-photo dan-photo-md"
      />
      <div class:list={['vl-me-copy', workLed && 'vl-me-copy-led']}>
        {meTitle ? <p class="vl-me-title">{meTitle}</p> : null}
        {meBody.map((para) => (
          <p>{para}</p>
        ))}
      </div>
    </section>
  ) : null}

  {!storyLed ? (
  <section id="work" class="vl-work">
    {workLed && config.workIntro ? (
      <div class="vl-work-lead">
        <p class="spine-break-title">
          {typeof workIntroTitle === 'string' ? (
            workIntroTitle
          ) : (
            <>{workIntroTitle.before}<span class="spine-mark">{workIntroTitle.mark}</span>{workIntroTitle.after}</>
          )}
        </p>
        {weaveLines(config.workIntro.text).map((line) => (
          <p class="spine-break-copy">{line}</p>
        ))}
      </div>
    ) : workLed ? null : (
      <p class="vl-work-intro">{config.value.headline}</p>
    )}

    {workLed ? (
      <div class="work-grid spine-work-led">
        {cases.map((study, i) => {
          const weavesHere = gridWeaves.filter((item) => item.after === i + 1);
          return (
            <>
              <WorkCard
                client:visible
                vimeoId={study.vimeoId}
                vimeoHash={study.vimeoHash}
                title={study.title}
                client={study.client}
                description={study.body}
                href={study.link}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              {weavesHere.map((weave) => {
                const lines = weaveLines(weave.text);
                const ctaHere =
                  Boolean(weave.cta) ||
                  (endWeaves.length === 0 && weave.after === lastGridAfter);
                const mark = weave.mark;
                const headline = weave.headline ?? '';
                const markAt = mark && headline.includes(mark) ? headline.indexOf(mark) : -1;
                const titleNode =
                  markAt >= 0 ? (
                    <>{headline.slice(0, markAt)}<span class="spine-mark">{mark}</span>{headline.slice(markAt + mark!.length)}</>
                  ) : (
                    headline
                  );

                if (weave.quote) {
                  return (
                    <blockquote class:list={[weave.wide ? 'work-grid-break vl-quote-wide' : 'spine-aside']}>
                      <p class="spine-break-title">“{weave.quote.text}”</p>
                      <footer>
                        {weave.quote.role
                          ? `${weave.quote.name}, ${weave.quote.role}`
                          : weave.quote.name}
                      </footer>
                    </blockquote>
                  );
                }

                if (weave.portrait) {
                  return (
                    <div class="work-grid-break vl-me vl-me-weave">
                      <img
                        src="/daniel-neale.jpg"
                        alt="Dan Neale"
                        width="72"
                        height="72"
                        class="dan-photo dan-photo-md"
                      />
                      <div class="vl-me-copy vl-me-copy-led">
                        {headline ? <p class="vl-me-title">{headline}</p> : null}
                        {lines.map((line) => (
                          <p>{line}</p>
                        ))}
                      </div>
                    </div>
                  );
                }

                return (
                  <div class="spine-aside">
                    {headline ? <p class="spine-break-title">{titleNode}</p> : null}
                    {lines.map((line) => (
                      <p class="spine-break-copy">{line}</p>
                    ))}
                    {ctaHere ? (
                      <div class="vl-weave-cta">
                        <a href="/book/" class="ms-btn">
                          {weave.ctaLabel ?? 'Book a call'}
                        </a>
                      </div>
                    ) : null}
                  </div>
                );
              })}
            </>
          );
        })}
      </div>
    ) : (
    <div class="work-grid">
      {cases.slice(0, 2).map((study, i) => (
        <WorkCard
          client:visible
          vimeoId={study.vimeoId}
          vimeoHash={study.vimeoHash}
          title={study.title}
          client={study.client}
          description={study.body}
          href={study.link}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))}

      <blockquote class="work-grid-break vl-break">
        <p>“{config.quote.text}”</p>
        <footer>
          {config.quote.name}
          <span>, {config.quote.role}</span>
        </footer>
      </blockquote>

      {cases.slice(2, 4).map((study) => (
        <WorkCard
          client:visible
          vimeoId={study.vimeoId}
          vimeoHash={study.vimeoHash}
          title={study.title}
          client={study.client}
          description={study.body}
          href={study.link}
        />
      ))}

      <ul class="work-grid-break vl-break-lines">
        {whyLines.map((item) => (
          <li>
            <span aria-hidden="true">→</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>

      {cases.slice(4).map((study) => (
        <WorkCard
          client:visible
          vimeoId={study.vimeoId}
          vimeoHash={study.vimeoHash}
          title={study.title}
          client={study.client}
          description={study.body}
          href={study.link}
        />
      ))}
    </div>
    )}

    {workLed ? null : (
      <p class="vl-all-work">
        <a href="/work/">See the full portfolio →</a>
      </p>
    )}

    {endWeaves.length > 0 ? (
      <div class="vl-end">
        {endWeaves.map((endWeave, idx) => {
          const endTitle = endWeave.headline
            ? markedTitle(endWeave.headline, endWeave.mark)
            : '';
          const showCta = Boolean(endWeave.cta) || idx === endWeaves.length - 1;
          return (
            <div class="vl-end-block">
              {endWeave.headline ? (
                <p class="spine-break-title">
                  {typeof endTitle === 'string' ? (
                    endTitle
                  ) : (
                    <>{endTitle.before}<span class="spine-mark">{endTitle.mark}</span>{endTitle.after}</>
                  )}
                </p>
              ) : null}
              {weaveLines(endWeave.text).map((line) => (
                <p class="spine-break-copy">{line}</p>
              ))}
              {showCta ? (
                <div class="vl-weave-cta">
                  <a href="/book/" class="ms-btn">
                    {endWeave.ctaLabel ?? 'Book a call'}
                  </a>
                </div>
              ) : null}
            </div>
          );
        })}
      </div>
    ) : closeParas.length > 0 && !workLed ? (
      <div class="vl-close">
        {closeParas.map((para) => (
          <p>{para}</p>
        ))}
        <a href="/book/" class="ms-btn">Book a call</a>
      </div>
    ) : null}
  </section>
  ) : null}

  {faqs.length > 0 ? (
    <section class="vl-faq">
      <div class="fold">
        {faqs.map((faq) => (
          <details class="fold-item">
            <summary>{faq.question}</summary>
            <div class="fold-body">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  ) : null}
</div>

<style>
  .vl {
    max-width: 80rem;
    margin: 0 auto;
    padding: 10rem 3.5rem 8rem;
  }

  .vl-hero {
    display: grid;
    gap: 2rem;
    margin-bottom: 3rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .vl-hero {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      gap: 3rem;
      margin-bottom: 4.5rem;
    }
  }

  .vl-hero-copy {
    max-width: 36rem;
    min-width: 0;
    container-type: inline-size;
  }

  .vl-kicker {
    display: block;
    margin: 0 0 2rem;
  }

  .vl-hero-film {
    min-width: 0;
  }

  .vl-hero-film.has-reel {
    overflow-x: clip;
  }

  .vl-title {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 0.9;
    margin: 0 0 2.5rem;
    color: var(--color-fg);
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .vl-title {
      font-size: 4.5rem;
    }
  }

  /* 72px beside the film, unless the longest word would leave the copy column. */
  @media (min-width: 900px) {
    .vl-title {
      font-size: min(4.5rem, calc((100cqi - 4px) / var(--vl-ems, 4.5)));
    }
  }

  .vl-lede {
    max-width: 34rem;
    margin: 0 0 1.75rem;
  }

  .vl-lede p {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #444;
    margin: 0 0 0.3rem;
  }

  .vl-lede p:last-child {
    margin-bottom: 0;
  }

  .vl-hero-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .vl-close {
    margin-top: 3.5rem;
    max-width: 32rem;
  }

  .vl-close p {
    margin: 0 0 0.3rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: #444;
  }

  .vl-close p:last-of-type {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--color-fg);
  }

  .vl-ticker {
    margin: 0 -0.25rem 2.5rem;
    padding: 1.25rem 0;
  }

  .vl-me {
    display: flex;
    align-items: flex-start;
    gap: 1.15rem;
    max-width: 40rem;
    margin: 0 0 3.5rem;
  }

  @media (min-width: 640px) {
    .vl-me {
      gap: 1.5rem;
    }
  }

  .vl-me-copy {
    min-width: 0;
    padding-top: 0.2rem;
  }

  .vl-me-copy p {
    margin: 0 0 0.3rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .vl-me-copy p:last-child {
    margin-bottom: 0;
  }

  .vl-me-copy-led p {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.5;
    color: #444;
  }

  .vl-me-copy-led .vl-me-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.22;
    color: var(--color-fg);
    margin: 0 0 0.75rem;
  }

  .vl-weave-cta {
    margin-top: 1.75rem;
  }

  .vl-end {
    margin-top: 4rem;
    max-width: 32rem;
  }

  .vl-end-block + .vl-end-block {
    margin-top: 3.25rem;
  }

  .vl-work-lead {
    margin: 0 0 3.25rem;
    max-width: 36rem;
  }

  .vl-quote-wide {
    max-width: 40rem;
    padding: 1.25rem 0 0.5rem;
  }

  .vl-quote-wide .spine-break-title {
    font-size: clamp(1.45rem, 2.6vw, 1.95rem);
    line-height: 1.28;
  }

  .vl-me-weave {
    margin: 0.5rem 0 0.25rem;
    max-width: 40rem;
  }

  .vl-work-intro {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 2.5rem;
    max-width: 28rem;
  }

  .vl-break {
    padding: 0.25rem 0 0.5rem;
    margin: 0;
  }

  .vl-break p {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin: 0 0 0.85rem;
    max-width: 40rem;
  }

  .vl-break footer {
    font-size: 0.8125rem;
    color: #7a7a7a;
  }

  .vl-break-lines {
    list-style: none;
    padding: 0.5rem 0 0.75rem;
    margin: 0;
    display: grid;
    gap: 1.15rem 2rem;
  }

  @media (min-width: 768px) {
    .vl-break-lines {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .vl-break-lines li {
    display: flex;
    gap: 0.65rem;
    font-size: 0.9875rem;
    line-height: 1.45;
    color: #333;
  }

  .vl-all-work {
    margin: 3rem 0 0;
    font-size: 0.875rem;
  }

  .vl-all-work a {
    border-bottom: 1px solid rgba(10, 10, 10, 0.2);
    padding-bottom: 0.15rem;
  }

  .vl-all-work a:hover {
    border-color: #0a0a0a;
  }

  .vl-faq {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(10, 10, 10, 0.1);
  }

  .vl-band {
