---
/**
 * Landing template — five bands on every vertical:
 * 1. Claim + hero film
 * 2. Client ticker
 * 3. Work grid (WorkCard, 2-col)
 * 4. Why-band (value + quote + 3 lines)
 * 5. FAQ (capped at 4) + related links
 *
 * Shared nav/footer via PageLayout. Ads/sales pages stay on their own skins.
 */
import VimeoEmbed from './VimeoEmbed';
import WorkCard from './WorkCard';
import ClientTicker from './ClientTicker';
import type { VerticalLandingConfig } from '../data/vertical-landings/types';

interface Props {
  config: VerticalLandingConfig;
}

const { config } = Astro.props;
const cases = config.cases;
const whyLines = config.benefits.items.slice(0, 3);
const faqs = config.faqs.slice(0, 4);
---

<div class="vl">
  <header class="vl-hero">
    <div class="vl-hero-copy">
      <p class="vl-eyebrow">{config.eyebrow}</p>
      <h1 class="vl-title">
        {config.headline.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h1>
      <p class="vl-lede">{config.lede}</p>
      <div class="vl-hero-cta">
        <a href="/book/" class="ms-btn">Book a call</a>
        <a href="#work" class="ms-link">See the work</a>
      </div>
    </div>
    <div class="vl-hero-film">
      <VimeoEmbed
        client:load
        vimeoId={config.heroVideo.vimeoId}
        vimeoHash={config.heroVideo.vimeoHash}
        title={config.heroVideo.title}
        loading="eager"
        autoColor={true}
        className="rounded-xl"
      />
    </div>
  </header>

  <section class="vl-ticker" aria-label={config.tickerLabel ?? 'Clients'}>
    <ClientTicker
      client:load
      label={config.tickerLabel ?? 'Clients'}
      rowA={config.tickerRowA}
      rowB={config.tickerRowB}
      compact
    />
  </section>

  <section id="work" class="vl-work">
    <div class="vl-section-head">
      <p class="vl-eyebrow">{config.workEyebrow ?? 'Selected work'}</p>
      <p class="vl-count">{String(cases.length).padStart(2, '0')}</p>
    </div>

    <div class="work-grid">
      {cases.map((study, i) => (
        <WorkCard
          client:visible
          vimeoId={study.vimeoId}
          vimeoHash={study.vimeoHash}
          title={study.title}
          client={study.client}
          description={study.body}
          href={study.link}
          loading={i < 2 ? 'eager' : 'lazy'}
        />
      ))}
    </div>

    <p class="vl-all-work">
      <a href="/work/">See the full portfolio →</a>
    </p>
  </section>

  <section class="vl-why">
    <div class="vl-why-copy">
      <h2 class="vl-why-title">{config.value.headline}</h2>
      <blockquote class="vl-why-quote">
        <p>“{config.quote.text}”</p>
        <footer>
          {config.quote.name}
          <span> — {config.quote.role}</span>
        </footer>
      </blockquote>
    </div>
    <ul class="vl-why-lines">
      {whyLines.map((item) => (
        <li>
          <span class="text-accent" aria-hidden="true">→</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="vl-faq">
    <p class="vl-eyebrow">Questions</p>
    <div class="fold">
      {faqs.map((faq) => (
        <details class="fold-item">
          <summary>{faq.question}</summary>
          <div class="fold-body">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  {config.links.length > 0 && (
    <nav class="vl-links" aria-label="Related pages">
      {config.links.map((link) => (
        <a href={link.href} class="vl-link-card">
          <span class="vl-eyebrow">{link.eyebrow}</span>
          <p>{link.label}</p>
        </a>
      ))}
    </nav>
  )}
</div>

<style>
  .vl {
    max-width: 80rem;
    margin: 0 auto;
    padding: 8.5rem 2rem 6rem;
  }

  @media (min-width: 768px) {
    .vl {
      padding: 9.5rem 2rem 8rem;
    }
  }

  .vl-eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7a7a7a;
    line-height: 1.4;
    margin: 0;
  }

  .vl-hero {
    display: grid;
    gap: 2rem;
    margin-bottom: 3rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .vl-hero {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      gap: 3rem;
      margin-bottom: 3.5rem;
    }
  }

  .vl-hero-copy {
    max-width: 34rem;
  }

  .vl-hero-film {
    min-width: 0;
  }

  .vl-title {
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 5.6vw, 4.15rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 1.25rem 0 1.5rem;
    color: var(--color-fg);
    text-wrap: balance;
  }

  .vl-lede {
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #555;
    margin: 0 0 1.75rem;
  }

  .vl-hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }

  .vl-ticker {
    margin: 0 -0.25rem 3.5rem;
    padding: 1.5rem 12rem 1.5rem 0;
    border-top: 1px solid rgba(10, 10, 10, 0.1);
    border-bottom: 1px solid rgba(10, 10, 10, 0.1);
  }

  @media (max-width: 767px) {
    .vl-ticker {
      padding-right: 8.5rem;
    }
  }

  .vl-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .vl-count {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: #b0b0b0;
    margin: 0;
  }

  .vl-all-work {
    margin: 3rem 0 0;
    font-size: 0.875rem;
  }

  .vl-all-work a {
    border-bottom: 1px solid rgba(10, 10, 10, 0.2);
    padding-bottom: 0.15rem;
  }

  .vl-all-work a:hover {
    border-color: #0a0a0a;
  }

  .vl-why {
    display: grid;
    gap: 2.5rem;
    margin-top: 5.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid rgba(10, 10, 10, 0.1);
  }

  @media (min-width: 900px) {
    .vl-why {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 4rem;
      align-items: start;
    }
  }

  .vl-why-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 1.75rem;
  }

  .vl-why-quote p {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin: 0 0 1rem;
  }

  .vl-why-quote footer {
    font-size: 0.8125rem;
    color: #7a7a7a;
  }

  .vl-why-lines {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .vl-why-lines li {
    display: flex;
    gap: 0.75rem;
    font-size: 0.9875rem;
    line-height: 1.5;
    color: #333;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid rgba(10, 10, 10, 0.08);
  }

  .vl-why-lines li:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .vl-faq {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(10, 10, 10, 0.1);
  }

  .vl-faq .vl-eyebrow {
    margin-bottom: 1.5rem;
  }

  .vl-links {
    display: grid;
    gap: 1px;
    margin-top: 4.5rem;
    border-top: 1px solid rgba(10, 10, 10, 0.1);
    background: rgba(10, 10, 10, 0.08);
  }

  @media (min-width: 700px) {
    .vl-links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .vl-link-card {
    display: block;
    background: #fff;
    padding: 1.75rem 0 1.75rem 0;
    transition: opacity 0.2s ease;
  }

  @media (min-width: 700px) {
    .vl-link-card {
      padding: 2rem 1.5rem 2rem 0;
    }

    .vl-link-card:nth-child(even) {
      padding-left: 1.5rem;
    }
  }

  .vl-link-card:hover {
    opacity: 0.7;
  }

  .vl-link-card .vl-eyebrow {
    margin-bottom: 0.75rem;
  }

  .vl-link-card p {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }
</style>
