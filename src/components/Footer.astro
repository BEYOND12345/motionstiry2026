---
import { STUDIO_PROOF } from '../data/reviews';
---

<footer class="site-footer">
  <div class="max-w-7xl mx-auto px-8 py-16 md:py-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-12 mb-12">
      <div>
        <span class="text-metadata mb-4 block">Work</span>
        <div class="flex flex-col gap-2">
          <a href="/work/" class="text-body !text-sm hover:text-black transition-colors">All work</a>
          <a href="/explainer-videos/" class="text-body !text-sm hover:text-black transition-colors">Explainer videos</a>
          <a href="/saas-explainer-videos/" class="text-body !text-sm hover:text-black transition-colors">SaaS motion graphics</a>
          <a href="/product-demo-videos/" class="text-body !text-sm hover:text-black transition-colors">Product demo videos</a>
          <a href="/product-launch-video/" class="text-body !text-sm hover:text-black transition-colors">Product launch videos</a>
          <a href="/motion-graphics/" class="text-body !text-sm hover:text-black transition-colors">Motion graphics</a>
        </div>
      </div>
      <div>
        <span class="text-metadata mb-4 block">Industries</span>
        <div class="flex flex-col gap-2">
          <a href="/finance-explainer-videos/" class="text-body !text-sm hover:text-black transition-colors">Fintech</a>
          <a href="/cybersecurity-explainer-videos/" class="text-body !text-sm hover:text-black transition-colors">Cybersecurity</a>
          <a href="/startups/" class="text-body !text-sm hover:text-black transition-colors">Startups</a>
          <a href="/technology-videos/" class="text-body !text-sm hover:text-black transition-colors">Technology</a>
          <a href="/agencies/" class="text-body !text-sm hover:text-black transition-colors">Agencies</a>
          <a href="/causes/" class="text-body !text-sm hover:text-black transition-colors">Causes & nonprofits</a>
        </div>
      </div>
      <div>
        <span class="text-metadata mb-4 block">Studio</span>
        <div class="flex flex-col gap-2">
          <a href="/about/" class="text-body !text-sm hover:text-black transition-colors">About</a>
          <a href="/process/" class="text-body !text-sm hover:text-black transition-colors">Process</a>
          <a href="/reviews/" class="text-body !text-sm hover:text-black transition-colors">Reviews</a>
          <a href="/blog/" class="text-body !text-sm hover:text-black transition-colors">Blog</a>
          <a href="/book/" class="text-body !text-sm hover:text-black transition-colors">Book a call</a>
          <a href="/contact/" class="text-body !text-sm hover:text-black transition-colors">Start a project</a>
        </div>
      </div>
      <div class="col-span-2 md:col-span-1">
        <span class="text-metadata mb-4 block">Connect</span>
        <a href="mailto:daniel@motionstory.com.au" class="text-body !text-sm hover:text-black transition-colors block mb-2">daniel@motionstory.com.au</a>
        <p class="text-body !text-sm mb-4">Byron Bay, Australia</p>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <a href="https://vimeo.com/wearemotionstory" class="text-body !text-sm hover:text-black transition-colors" target="_blank" rel="noopener">Vimeo</a>
          <a href="https://www.linkedin.com/in/danielneale" class="text-body !text-sm hover:text-black transition-colors" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://www.behance.net/motion_story" class="text-body !text-sm hover:text-black transition-colors" target="_blank" rel="noopener">Behance</a>
          <a href="https://dribbble.com/motionstory" class="text-body !text-sm hover:text-black transition-colors" target="_blank" rel="noopener">Dribbble</a>
        </div>
      </div>
    </div>

    <div class="pt-8 border-t border-black/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <span class="text-metadata"><span class="brand-mark text-[13px]">MotionStory</span>. Complexity Explained.</span>
      <p class="text-metadata">
        {STUDIO_PROOF.map((item, i) => (
          <span>
            {i > 0 && <span class="text-black/20"> · </span>}
            <a
              href={item.href}
              class="hover:text-black transition-colors"
              target={'external' in item && item.external ? '_blank' : undefined}
              rel={'external' in item && item.external ? 'noopener' : undefined}
            >
              {item.label}
            </a>
          </span>
        ))}
      </p>
      <a href="/privacy-policy/" class="text-metadata hover:text-black transition-colors">Privacy Policy</a>
    </div>
  </div>
</footer>
