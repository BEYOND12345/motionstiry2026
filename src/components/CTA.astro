---
interface Props {
  heading?: string;
  label?: string;
}

const { heading = "Tell me what you are trying to explain.", label = "Start a Project" } = Astro.props;
---

<section class="site-cta">
  <div class="max-w-6xl mx-auto px-8 py-28 md:py-32 text-center">
    <span class="text-metadata !text-white/40 mb-8 block">{label}</span>
    <h2 class="font-display text-3xl md:text-6xl font-bold tracking-tight mb-12">
      {heading}
    </h2>
    <a
      href="mailto:daniel@motionstory.com.au"
      class="ms-btn-on-dark"
      data-astro-reload
    >
      Email Dan
    </a>
  </div>
</section>
