---
interface Props {
  heading?: string;
  label?: string;
}

const { heading = "Got something complex to explain?", label = "Start a Project" } = Astro.props;
---

<section class="site-cta">
  <div class="max-w-6xl mx-auto px-8 py-28 md:py-32 text-center">
    <span class="text-metadata !text-white/40 mb-8 block">{label}</span>
    <h2 class="font-display text-3xl md:text-6xl font-bold tracking-tight mb-12">
      {heading}
    </h2>
    <a
      href="mailto:daniel@motionstory.com.au?subject=Project%20enquiry"
      class="font-display text-lg md:text-2xl font-bold tracking-tight border-b border-white/25 pb-2 hover:border-accent transition-colors"
    >
      Email Dan <span class="text-accent">→</span>
    </a>
  </div>
</section>
