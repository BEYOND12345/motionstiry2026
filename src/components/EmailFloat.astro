---
interface Props {
  /** Kept for call-site compatibility; mailto is plain by request */
  subject?: string;
  label?: string;
}

const { label = 'Email Dan' } = Astro.props;
const href = 'mailto:daniel@motionstory.com.au';
---

<a
  href={href}
  class="landing-float"
  aria-label="Email Dan"
  data-astro-reload
>
  <span class="landing-float-label">{label}</span>
  <span class="landing-float-arrow" aria-hidden="true">→</span>
</a>
